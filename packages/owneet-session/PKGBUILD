pkgname=owneet-session
pkgver=0.0.6
pkgrel=1
pkgdesc="OwneetOS console session: console user, autologin, compositor choice (gamescope or cage)"
arch=('any')
url="https://github.com/fancy-dino/OwneetOS"
license=('GPL-3.0-or-later')
depends=('bash' 'systemd' 'util-linux' 'gamescope' 'cage' 'mpv' 'vulkan-tools' 'ttf-dejavu')
source=(owneet-session owneet-placeholder owneet-session.profile.sh owneet-autologin.conf owneet.sysusers owneet.tmpfiles)
sha256sums=('2ff8a94e6d31ca5ab17d5c1c0841c11f2924ca29d9ef6d524e80b836425f6778'
            'f4353688233d95d00b5b85a0b8cdeae7cf9456afd90b83eb2bdce1632dba1468'
            '8ad352c32ba71d1b9f1867dd6e53ca56c7a960e771bf10950a7e201230a9bd0c'
            '9d99b689604e901a5b47f58ed8d436a7d88f4b9d24274982acccb14831fa0971'
            '8f429ac5cae3e2851cc2a1b9667bdb6a59e702df70e559ec017122a42cabe96f'
            '2763838f424a2128b8c576602b35bd4c0dd90798a687dc1c72b81f6facceb4f5')

package() {
  install -Dm755 owneet-session owneet-placeholder -t "$pkgdir/usr/bin/"
  install -Dm644 owneet-session.profile.sh "$pkgdir/etc/profile.d/owneet-session.sh"
  install -Dm644 owneet-autologin.conf "$pkgdir/usr/lib/systemd/system/getty@tty1.service.d/owneet-autologin.conf"
  install -Dm644 owneet.sysusers "$pkgdir/usr/lib/sysusers.d/owneet.conf"
  install -Dm644 owneet.tmpfiles "$pkgdir/usr/lib/tmpfiles.d/owneet.conf"
}
