#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
#
# OwneetOS console session. Started on tty1 for the console user (see owneet-session.profile.sh).
# Chooses the compositor, starts the console UI in it and restarts it if it stops:
#   - gamescope when a hardware Vulkan device exists (main session),
#   - cage otherwise, or when gamescope keeps failing (reduced session, PROJECT_RULES.md section 3).
#
# Kernel command line options:
#   owneet.session=auto|gamescope|cage   force a mode (default: auto)
# Test hooks (troubleshooting; never needed by users):
#   owneet.debug.gamescope_backend=headless   gamescope without a screen, for VMs without a
#                                             hardware Vulkan device (windows and focus still work)
#   owneet.debug.gamescope_composite=force|off
#                                             always composite / never force it (default: forced
#                                             with the NVIDIA driver only, see gamescope_args)
#   owneet.debug.gamescope_steam=off          gamescope without --steam (no focus control)
#   owneet.debug.test_games=on                two test "games" (mpv test patterns), for testing
#                                             launching, Guide and Resume on a live system

set -uo pipefail

# The console interface; the placeholder only if it is not installed.
APP="${OWNEET_APP:-/usr/bin/owneet-frontend}"
if [[ ! -x "$APP" ]]; then APP=/usr/bin/owneet-placeholder; fi
# Publishes the session's display for owneetd, then runs the app.
SESSION_APP=/usr/lib/owneet/owneet-session-app
QUICK_EXIT_S=30          # a compositor that stops sooner than this counts as a failure
GAMESCOPE_MAX_FAILS=2    # then fall back to cage
CAGE_MAX_FAILS=3         # then show an error and wait before trying again

# Technical messages go to the journal only (journalctl -t owneet-session); the screen is for users.
log() {
    echo "$*" | systemd-cat -t owneet-session 2>/dev/null || true
}

cmdline_mode() {
    local m
    m="$(grep -oE '(^| )owneet\.session=[a-z]+' /proc/cmdline | tail -1 | cut -d= -f2)"
    echo "${m:-auto}"
}

has_hardware_vulkan() {
    # lavapipe (software, CPU) does not count: it is too slow for the main session.
    vulkaninfo --summary 2>/dev/null \
        | grep -qE 'deviceType += PHYSICAL_DEVICE_TYPE_(INTEGRATED_GPU|DISCRETE_GPU|VIRTUAL_GPU)'
}

# Value of a test hook on the kernel command line: owneet.debug.NAME=VALUE.
debug_opt() {
    grep -oE "(^| )owneet\.debug\.$1=[a-z]+" /proc/cmdline | tail -1 | cut -d= -f2 || true
}

# gamescope's arguments, in GAMESCOPE_ARGS.
gamescope_args() {
    # --steam: gamescope shows the windows owneetd tags and lets it choose which one is on screen
    # (home screen or game, Guide button). docs/daemon-design.md, "Apps and games".
    GAMESCOPE_ARGS=(--fullscreen --steam)
    if [[ "$(debug_opt gamescope_steam)" == off ]]; then GAMESCOPE_ARGS=(--fullscreen); fi
    if [[ "$(debug_opt gamescope_backend)" == headless ]]; then GAMESCOPE_ARGS+=(--backend headless); fi
    # With the NVIDIA driver, windows sent straight to the screen (direct scanout) show flickering
    # black rectangles (owner's RTX 4060, 2026-10-08): always composite there. AMD and Intel keep
    # direct scanout, which saves GPU work on low-end hardware.
    case "$(debug_opt gamescope_composite)" in
        force) GAMESCOPE_ARGS+=(--force-composition) ;;
        off)   ;;
        *)     if [[ -d /sys/module/nvidia_drm ]]; then GAMESCOPE_ARGS+=(--force-composition); fi ;;
    esac
}

run_compositor() {
    export OWNEET_SESSION_MODE="$1"
    # Read by owneetd (GET /v1/status).
    mkdir -p "${XDG_RUNTIME_DIR:-/tmp}/owneet"
    echo "$1" > "${XDG_RUNTIME_DIR:-/tmp}/owneet/session-mode"
    # Stale until the new session publishes its display.
    rm -f "${XDG_RUNTIME_DIR:-/tmp}/owneet/session-env"
    case "$1" in
        gamescope) gamescope_args
                   log "gamescope ${GAMESCOPE_ARGS[*]}"
                   gamescope "${GAMESCOPE_ARGS[@]}" -- "$SESSION_APP" "$APP" ;;
        # The reduced session must work even without GPU acceleration (no driver, or a VM):
        # wlroots then renders in software instead of refusing to start.
        cage)      WLR_RENDERER_ALLOW_SOFTWARE=1 cage -s -- "$SESSION_APP" "$APP" ;;
    esac
}

# Test games: mpv test patterns that open a window and run until closed (boot menu entry
# "OwneetOS (test games)"; the live system keeps nothing, so they are created at every boot).
add_test_games() {
    local dir="$HOME/owneet-test-games" cfg="$HOME/.config/owneet-frontend"
    local mpv="mpv --no-config --loop --vo=gpu-next,gpu,x11"
    mkdir -p "$dir" "$cfg"
    printf 'collection: Test games\n\n' > "$dir/metadata.pegasus.txt"
    printf 'game: Test Uno\nfile: /etc/hostname\nlaunch: %s av://lavfi:testsrc2\n\n' "$mpv" >> "$dir/metadata.pegasus.txt"
    printf 'game: Test Due\nfile: /etc/os-release\nlaunch: %s av://lavfi:smptebars\n\n' "$mpv" >> "$dir/metadata.pegasus.txt"
    grep -qxF "$dir" "$cfg/game_dirs.txt" 2>/dev/null || echo "$dir" >> "$cfg/game_dirs.txt"
    log "test games added in $dir"
}
if [[ "$(debug_opt test_games)" == on ]]; then add_test_games; fi

mode="$(cmdline_mode)"
case "$mode" in
    gamescope|cage) log "mode forced on the kernel command line: $mode" ;;
    auto)
        if has_hardware_vulkan; then mode=gamescope; else mode=cage; fi
        log "Vulkan check: using $mode"
        ;;
    *) log "unknown owneet.session=$mode, using auto"; mode=cage
       if has_hardware_vulkan; then mode=gamescope; fi ;;
esac

# The compositor can only start while this session is the one on screen (logind "active"): not
# while another console is shown (e.g. the diagnostics report on tty9). Wait for it instead of
# counting failed starts.
wait_until_active() {
    local id="${XDG_SESSION_ID:-}" said=0
    [[ -n "$id" ]] || return 0
    while [[ "$(loginctl show-session "$id" -p Active --value 2>/dev/null)" == no ]]; do
        if (( ! said )); then log "the console is not on screen: waiting"; said=1; fi
        sleep 1
    done
}

fails=0
while true; do
    wait_until_active
    log "starting $mode"
    start=$SECONDS
    # Compositor and app messages go to the journal (journalctl -t owneet-cage / owneet-gamescope),
    # never to the screen.
    run_compositor "$mode" 2>&1 | systemd-cat -t "owneet-$mode"
    rc=${PIPESTATUS[0]}
    ran=$(( SECONDS - start ))
    log "$mode stopped (exit code $rc) after ${ran}s"

    if (( ran < QUICK_EXIT_S )); then fails=$(( fails + 1 )); else fails=0; fi

    if [[ "$mode" == gamescope ]] && (( fails >= GAMESCOPE_MAX_FAILS )); then
        log "gamescope failed $fails times in a row: falling back to cage"
        mode=cage
        fails=0
    elif [[ "$mode" == cage ]] && (( fails >= CAGE_MAX_FAILS )); then
        log "the console cannot start; retrying in 60s"
        clear
        printf '\n\n  OwneetOS could not start its interface.\n  It will try again in one minute.\n'
        sleep 60
        fails=0
        continue
    fi
    log "restarting"
    sleep 1
done
