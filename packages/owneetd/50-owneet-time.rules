// SPDX-License-Identifier: GPL-3.0-or-later
// owneetd (the console user) sets the time zone chosen at the first start or in Settings, keeps
// the clock synchronised from the internet, and, without the internet, sets the date and time the
// player enters by hand ([[step-6.1-first-boot-flow]]). Only these three actions of
// systemd-timedated, only the console user in the active local session.
polkit.addRule(function (action, subject) {
    if ((action.id === "org.freedesktop.timedate1.set-timezone" ||
            action.id === "org.freedesktop.timedate1.set-ntp" ||
            action.id === "org.freedesktop.timedate1.set-time") &&
            subject.user === "owneet" && subject.local && subject.active) {
        return polkit.Result.YES;
    }
});
