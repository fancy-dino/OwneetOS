#!/bin/bash
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Starts a GOG DOS game with Linux's own DOSBox instead of the Windows DOSBox GOG ships with it
# ([[step-4.5-windows-games-proton]], owner 2026-10-16: no Proton for them; under Proton, GOG's
# DOSBox ended when the home screen was shown). DOS games are small: the first start copies the
# game's folder to the console's disk (with GOG's starting saves, __support/save), so that the game
# can write its settings and saves there; the game's disk (read only) is never written.
# GOG's DOSBox configuration files are used as they are, with their paths made Linux ones; the
# "cloud_saves" overlay of GOG's DOSBox is not needed (the copy is writable).
#
#   owneet-dos-run DATA GAME_DIR WORKDIR [GOG's ARGUMENTS...]
#
# DATA: the game's folder on the console's disk; WORKDIR: GOG's working folder, relative to the
# game's folder (e.g. DOSBOX); the arguments are GOG's play task's (-conf FILE …, -c COMMAND).

set -u

if [[ $# -lt 3 ]]; then
    echo "usage: owneet-dos-run DATA GAME_DIR WORKDIR [ARGUMENTS...]" >&2
    exit 2
fi
data="$1" game="$2" work="$3"
shift 3
copy="$data/game"

# A path written for Windows (backslashes, any case), relative to a folder, as found on the disk
resolve() {
    local out="$1" part m
    local path="${2//\\//}"
    local -a parts
    IFS=/ read -ra parts <<< "$path"
    for part in "${parts[@]}"; do
        case "$part" in
            ''|.) continue ;;
            ..) out="$(dirname "$out")"; continue ;;
        esac
        m="$(find "$out" -mindepth 1 -maxdepth 1 -iname "$part" -print -quit 2>/dev/null)"
        if [[ -z "$m" ]]; then
            echo "$out/$part"
            return 1
        fi
        out="$m"
    done
    echo "$out"
}

# ---- The first start: the game on the console's disk
if [[ ! -f "$data/copied" ]]; then
    echo "owneet-dos-run: copying $game to the console's disk"
    rm -rf "$copy"
    mkdir -p "$copy"
    cp -a "$game/." "$copy/" || { echo "owneet-dos-run: cannot copy the game" >&2; exit 1; }
    chmod -R u+w "$copy"
    # GOG's starting saves (its install puts them in the overlay folder, i.e. on C:)
    save="$(resolve "$copy" "__support/save")"
    [[ -d "$save" ]] && cp -an "$save/." "$copy/"
    touch "$data/copied"
fi

cwd="$(resolve "$copy" "$work")" || cwd="$copy"

# ---- GOG's configuration files, with Linux paths in the [autoexec] mounts
mkdir -p "$data/conf"
rewrite() {
    local in="$1" out="$2" section="" line rest path
    : > "$out"
    while IFS= read -r line || [[ -n "$line" ]]; do
        line="${line%$'\r'}"
        if [[ "$line" =~ ^[[:space:]]*\[([A-Za-z0-9_]+)\] ]]; then
            section="${BASH_REMATCH[1],,}"
        fi
        if [[ "$section" == autoexec && "$line" =~ ^([[:space:]]*@?(img)?mount[[:space:]]+[^[:space:]]+[[:space:]]+)\"([^\"]*)\"(.*)$ ]]; then
            rest="${BASH_REMATCH[4]}"
            # the cloud saves overlay of GOG's DOSBox: not needed, the copy is writable
            if [[ "${rest,,}" == *"-t overlay"* ]]; then
                continue
            fi
            path="$(resolve "$cwd" "${BASH_REMATCH[3]}")"
            line="${BASH_REMATCH[1]}\"$path\"$rest"
        fi
        printf '%s\n' "$line" >> "$out"
    done < "$in"
}

args=() n=0
while [[ $# -gt 0 ]]; do
    case "$1" in
        -conf)
            if [[ $# -ge 2 ]]; then
                n=$((n + 1))
                src="$(resolve "$cwd" "$2")" && rewrite "$src" "$data/conf/$n.conf" && args+=(-conf "$data/conf/$n.conf")
                shift 2
                continue
            fi
            ;;
        -noconsole) shift; continue ;;          # Windows only
    esac
    args+=("$1")
    shift
done

# On the console's screen: full screen at the screen's size, drawn with OpenGL
cat > "$data/conf/owneet.conf" <<'EOF'
[sdl]
fullscreen=true
fullresolution=desktop
output=opengl
EOF

cd "$cwd" || exit 1
echo "owneet-dos-run: dosbox ${args[*]} -conf $data/conf/owneet.conf  (in $cwd)"
exec dosbox "${args[@]}" -conf "$data/conf/owneet.conf"
