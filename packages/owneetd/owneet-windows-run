#!/bin/bash
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Starts a Windows game ([[step-4.5-windows-games-proton]]) with umu-launcher and the Proton that
# owneetd made ready (its folder is in ~/.local/share/owneet/windows/proton), never downloading
# anything at the game's start: the Steam Linux Runtime is not updated here either (owneetd's
# preparation does that). One prefix per game, in the console's own disk.
#
#   owneet-windows-run PREFIX GAME.EXE [ARGUMENTS...]
#
# Started by the interface through owneetd (POST /v1/apps/launch), in the game's own service.

set -u

data="${XDG_DATA_HOME:-$HOME/.local/share}/owneet/windows"
if [[ $# -lt 2 ]]; then
    echo "usage: owneet-windows-run PREFIX GAME.EXE [ARGUMENTS...]" >&2
    exit 2
fi
proton="$(cat "$data/proton" 2>/dev/null)"
if [[ -z "$proton" || ! -x "$proton/proton" ]]; then
    echo "owneet-windows-run: Windows games are not ready yet" >&2
    exit 3
fi
prefix="$1"
shift
mkdir -p "$prefix"

# umu writes its umu-shim (a short script ending in exec "$@") once, and writes it again only when it
# is missing: one left empty by a hard stop made every Windows game end at once, with no error
# ([[windows-games-quit-at-once-empty-umu-shim]]). A shim that would not start the game is removed,
# and umu writes it again before it starts the game.
shim="${XDG_DATA_HOME:-$HOME/.local/share}/umu/umu-shim"
if [[ -e "$shim" ]] && ! grep -qsF 'exec "$@"' "$shim"; then
    echo "owneet-windows-run: umu-shim was broken ($(stat -c %s "$shim") bytes): removed, umu writes it again" >&2
    rm -f "$shim"
fi

export WINEPREFIX="$prefix" PROTONPATH="$proton" GAMEID="${GAMEID:-umu-default}" UMU_RUNTIME_UPDATE=0
# No pointer or mapping added inside games (owner, 2026-10-16, [[games-on-disk]]): GE-Proton's
# Xalia (the controller as a mouse in Windows programs) stays off
export PROTON_USE_XALIA=0
# Steam's virtual controller (28de:11ff, made while Steam runs) sends nothing to a game started
# outside Steam, yet Proton read it as the game's first controller, before the real one (The
# Witcher 2 on FrankenPC, 2026-11-09, [[step-4.5-windows-games-proton]]). With this, Proton leaves
# it out ("ignoring steam input virtual controller") and the real controllers come through SDL.
export PROTON_NO_STEAMINPUT=1

# Testers: owneet.debug.windows_log=on (boot menu, or owneet-debug.txt on the OWNEETLOG stick)
# writes Proton's log in ~/.local/share/owneet/windows/logs/<game> (the test report copies it),
# with every file the game opens and how it went (e.g. a game that cannot write in its folder)
if grep -qs 'owneet.debug.windows_log=on' /proc/cmdline /run/owneet-testlog/owneet-debug.txt; then
    logs="$data/logs/$(basename "$prefix")"
    mkdir -p "$logs"
    export PROTON_LOG=1 PROTON_LOG_DIR="$logs" WINEDEBUG="+timestamp,+pid,+tid,+loaddll,+process,+file"
    echo "owneet-windows-run: $*  (in $PWD)"
fi
exec umu-run "$@"
