pkgname=owneetd
pkgver=0.17.0
pkgrel=1
pkgdesc="OwneetOS system daemon (controllers, Guide button, Wi-Fi, Bluetooth, audio, power, apps, display, web apps) and owneetctl"
arch=('x86_64')
url="https://github.com/fancy-dino/OwneetOS"
# owneetd: GPL-3.0-or-later; SDL_GameControllerDB: Zlib; vendored Go modules (daemon/vendor/):
# godbus/dbus BSD-2-Clause, golang.org/x/sys BSD-3-Clause, jezek/xgb BSD-3-Clause, jfreymuth/pulse MIT
license=('GPL-3.0-or-later' 'Zlib' 'BSD-2-Clause' 'BSD-3-Clause' 'MIT')
# ddcutil: brightness of monitors (DDC/CI); hwdata: screen makers' names (as gamescope shows them)
# (umu-launcher, which owneetd uses for Windows games, comes with owneet-base: it is in [multilib],
# which the build chroot does not have)
depends=('systemd' 'bluez' 'networkmanager' 'polkit' 'pipewire-pulse' 'ddcutil' 'hwdata')
makedepends=('go')
options=('!debug')
install=owneetd.install
# SDL_GameControllerDB, pinned: tells owneetd which button is Guide on generic controllers.
_sdldb=c1d5289a1f713b30a2c121e9fe6529d39360be0f
# owneetd-src.tar.gz is generated from daemon/ by tools/build-packages (listed in source-dirs).
source=('owneetd-src.tar.gz' 'owneetd.service' '50-owneetd.preset'
        '70-owneet-uinput.rules' 'owneet-uinput.modules-load.conf' '50-owneet-networkmanager.rules'
        'owneet-screens-off@.service' '50-owneet-screens.rules' 'owneet-windows-run' 'owneet-dos-run'
        "gamecontrollerdb-$_sdldb.txt::https://raw.githubusercontent.com/mdqinc/SDL_GameControllerDB/$_sdldb/gamecontrollerdb.txt"
        "gamecontrollerdb-LICENSE-$_sdldb::https://raw.githubusercontent.com/mdqinc/SDL_GameControllerDB/$_sdldb/LICENSE"
        '50-owneet-time.rules')
sha256sums=('SKIP'
            'fb009505ebefa5dea078102c8b53950a8f0ace98b0d91ae5cedf2454d874d858'
            '2a0b34565694c894f522721980ee014d8ada9e5ca6e77be199aaf845e87170fb'
            '05704193de80d2e0de3f1fe137d3b189b9c29986a2976ae87c5b6da1d64642c8'
            '31a567f64e305e209a81c69a5d00593eb0a6a9f82248a6627ab0066d272a2ea8'
            'fd39be370627656bfc6ac2df05fbace5fced1699b1a1b62fac77d5d1a99d2536'
            '53db6bb4d6294d2a72032d440cedd8221a54fa24a89a717efb7eab557ffaa504'
            '2eef4c58614327306c3346fbb04fe242b2be8f6cbcc521e4fdec6655e4e96208'
            '5c6fe4dd1f35027245436b565a8a2e3ddaf0862c9c627797dedd5045c842d573'
            'c83933112b546701d5d6466d7958916d8ffbd120cf048ef1e5be4cb4221e051b'
            'e606134678e6b3fdbdec9081289a1f0ba3e25d53b59b2aa3cdfe69bf491ad18f'
            '97f35b302b361680ec1e891e95d2d52097bb95abff361434916d99dc1305f127'
            'eb0953198d6b584ffe66c727bbb9bd19593792cf369a92f1b8f7edbf8a5f2753')

_ldflags() {
  echo "-s -w -X github.com/fancy-dino/OwneetOS/daemon/internal/version.Version=$pkgver"
}

build() {
  cd daemon
  # Dependencies are vendored in daemon/vendor/: the build needs no network.
  export CGO_ENABLED=0 GOFLAGS="-trimpath -mod=vendor"
  go build -ldflags "$(_ldflags)" -o owneetd ./cmd/owneetd
  go build -ldflags "$(_ldflags)" -o owneetctl ./cmd/owneetctl
  go build -ldflags "$(_ldflags)" -o owneet-screens-off ./cmd/owneet-screens-off
  go build -ldflags "$(_ldflags)" -o owneet-bridge ./cmd/owneet-bridge
  go build -ldflags "$(_ldflags)" -o owneet-xprobe ./cmd/owneet-xprobe
}

check() {
  cd daemon
  CGO_ENABLED=0 GOFLAGS="-mod=vendor" go test ./...
}

package() {
  install -Dm755 daemon/owneetd daemon/owneetctl -t "$pkgdir/usr/bin/"
  # owneet-screens-off; owneet-bridge, started by Brave for the console's extension ([[extension-design]])
  install -Dm755 daemon/owneet-screens-off daemon/owneet-bridge -t "$pkgdir/usr/lib/owneet/"
  install -Dm755 owneet-windows-run owneet-dos-run -t "$pkgdir/usr/lib/owneet/"
  # Testers: owneet-xprobe (gamescope's windows and focus), recorded by owneet-testlog every 10 s
  # without anything copied onto a stick (2026-10-17)
  install -Dm755 daemon/owneet-xprobe -t "$pkgdir/usr/lib/owneet/"
  # Its native-messaging manifest: Brave reads hosts only from this system folder, not from the
  # web apps' profiles (--user-data-dir); only the console's extension may start it
  install -Dm644 daemon/cmd/owneet-bridge/org.owneet.bridge.json -t "$pkgdir/etc/opt/chrome/native-messaging-hosts/"
  install -Dm644 owneet-screens-off@.service -t "$pkgdir/usr/lib/systemd/system/"
  install -Dm644 50-owneet-screens.rules "$pkgdir/usr/share/polkit-1/rules.d/50-owneet-screens.rules"
  install -Dm644 50-owneet-time.rules "$pkgdir/usr/share/polkit-1/rules.d/50-owneet-time.rules"
  install -Dm644 owneetd.service "$pkgdir/usr/lib/systemd/user/owneetd.service"
  install -Dm644 50-owneetd.preset "$pkgdir/usr/lib/systemd/user-preset/50-owneetd.preset"
  install -Dm644 70-owneet-uinput.rules "$pkgdir/usr/lib/udev/rules.d/70-owneet-uinput.rules"
  install -Dm644 owneet-uinput.modules-load.conf "$pkgdir/usr/lib/modules-load.d/owneet-uinput.conf"
  install -Dm644 50-owneet-networkmanager.rules "$pkgdir/usr/share/polkit-1/rules.d/50-owneet-networkmanager.rules"
  install -Dm644 "gamecontrollerdb-$_sdldb.txt" "$pkgdir/usr/share/owneet/gamecontrollerdb.txt"
  install -Dm644 "gamecontrollerdb-LICENSE-$_sdldb" "$pkgdir/usr/share/licenses/$pkgname/LICENSE.gamecontrollerdb"
  install -Dm644 daemon/vendor/github.com/godbus/dbus/v5/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE.godbus-dbus"
  install -Dm644 daemon/vendor/golang.org/x/sys/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE.golang-x-sys"
  install -Dm644 daemon/vendor/golang.org/x/sys/PATENTS "$pkgdir/usr/share/licenses/$pkgname/PATENTS.golang-x-sys"
  install -Dm644 daemon/vendor/github.com/jfreymuth/pulse/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE.jfreymuth-pulse"
  install -Dm644 daemon/vendor/github.com/jezek/xgb/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE.jezek-xgb"
}
