pkgname=owneet-branding
pkgver=0.0.5
pkgrel=1
pkgdesc="OwneetOS visual identity: logo and boot splash (Plymouth theme)"
arch=('any')
url="https://github.com/fancy-dino/OwneetOS"
license=('GPL-3.0-or-later')
depends=('plymouth')
makedepends=('librsvg')
install=owneet-branding.install
# owneetos-splash.svg is generated by tools/branding/make-logo (do not edit by hand).
source=('owneetos-splash.svg' 'owneet.plymouth' 'plymouth-poweroff-show.conf')
sha256sums=('2c0cf45a1f395914c368e8dd31a743677642b8f339e01cdcb3f0022388460c82'
            '2285cfb030c718af9bfb60bdca4df7febcef015aa38997c959ae6e5625bbc96d'
            '2bae2da64690a3bd53a2d0a202233a8a0a38fb5a6facd031475efeaa91036fce')

build() {
  rsvg-convert -w 800 owneetos-splash.svg -o watermark.png

  # Spinner: a white arc turning over a faint ring, 36 frames of 10 degrees (neutral: the
  # palette's colours come with the console's start-up animation, owner 2026-10-15).
  local i n
  for i in $(seq 0 35); do
    printf -v n '%04d' $((i + 1))
    cat > frame.svg <<SVG
<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 48 48">
  <circle cx="24" cy="24" r="18" fill="none" stroke="#FFFFFF" stroke-opacity="0.18" stroke-width="4"/>
  <path d="M24 6 A18 18 0 0 1 42 24" fill="none" stroke="#FFFFFF" stroke-width="4"
        stroke-linecap="round" transform="rotate($((i * 10)) 24 24)"/>
</svg>
SVG
    rsvg-convert frame.svg -o "throbber-$n.png"
  done
}

package() {
  install -Dm644 owneetos-splash.svg "$pkgdir/usr/share/owneet/branding/owneetos-splash.svg"
  install -Dm644 plymouth-poweroff-show.conf "$pkgdir/usr/lib/systemd/system/plymouth-poweroff.service.d/owneet-show.conf"

  local theme="$pkgdir/usr/share/plymouth/themes/owneet"
  install -Dm644 owneet.plymouth watermark.png throbber-*.png -t "$theme/"
  # Prompt images (password prompts) come from Plymouth's spinner theme (GPL-2.0-or-later).
  # They are copied, not linked: only the selected theme is put in the initramfs, and the
  # two-step module refuses to load (falling back to the text splash) if any of them is missing.
  local f
  for f in bullet.png capslock.png entry.png keyboard.png keymap-render.png lock.png; do
    install -Dm644 "/usr/share/plymouth/themes/spinner/$f" "$theme/$f"
  done

}
