# "Starting" under the spinner of the boot splash: as soon as the disk with the chosen language is there.
[Unit]
Description=The start-up message on the boot splash
DefaultDependencies=no
After=plymouth-start.service local-fs.target
Before=sysinit.target
ConditionKernelCommandLine=splash

[Service]
Type=oneshot
ExecStart=/usr/lib/owneet/owneet-splash-message splash.starting
