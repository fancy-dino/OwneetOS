[Plymouth Theme]
Name=OwneetOS
Description=OwneetOS boot splash: the wordmark and a coral spinner on deep navy.
ModuleName=two-step

[two-step]
Font=Adwaita Sans 12
TitleFont=Adwaita Sans Light 30
MonospaceFont=Adwaita Mono 12
ImageDir=/usr/share/plymouth/themes/owneet
DialogHorizontalAlignment=.5
DialogVerticalAlignment=.382
TitleHorizontalAlignment=.5
TitleVerticalAlignment=.382
HorizontalAlignment=.5
VerticalAlignment=.64
WatermarkHorizontalAlignment=.5
WatermarkVerticalAlignment=.46
Transition=none
TransitionDuration=0.0
BackgroundStartColor=0x0e1424
BackgroundEndColor=0x0e1424
ProgressBarBackgroundColor=0x222d4a
ProgressBarForegroundColor=0xff8a5b
MessageBelowAnimation=true

[boot-up]
UseEndAnimation=false

[shutdown]
UseEndAnimation=false

[reboot]
UseEndAnimation=false
