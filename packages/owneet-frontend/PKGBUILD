pkgname=owneet-frontend
pkgver=0.23.3
pkgrel=1
pkgdesc="OwneetOS console interface, a modified version of Pegasus Frontend by Mátyás Mustoha and contributors"
arch=('x86_64')
url="https://github.com/fancy-dino/OwneetOS"
# owneet-frontend / Pegasus Frontend: GPL-3.0-or-later with additional terms (LICENSE.md);
# SortFilterProxyModel: MIT; bundled Bricolage Grotesque and Lexend fonts: OFL-1.1;
# bundled SDL_GameControllerDB: Zlib
license=('GPL-3.0-or-later' 'MIT' 'OFL-1.1' 'Zlib' 'CC0-1.0')
depends=('qt5-base' 'qt5-declarative' 'qt5-multimedia' 'qt5-svg' 'sdl2-compat' 'libxcb'
         'owneet-branding')
# ffmpeg: the interface sounds are converted when the package is built ([[interface-sounds-spec]])
makedepends=('cmake' 'ninja' 'qt5-tools' 'ffmpeg')
# !lto: Qt's two-pass resource compiler (rcc, big resources) fails with LTO objects.
options=('!debug' '!lto')
# owneet-frontend-src.tar.gz is generated from frontend/owneet-frontend by tools/build-packages.
source=('owneet-frontend-src.tar.gz')
sha256sums=('SKIP')

build() {
  cmake -S frontend/owneet-frontend -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DPEGASUS_ENABLE_LTO=OFF \
    -DOWNEET_VERSION="$pkgver" \
    -DOWNEET_DATE="$(date -u -d "@${SOURCE_DATE_EPOCH:-0}" +%F)"
  ninja -C build

  # Interface sounds ([[interface-sounds-spec]]): the delivered files stay as made; here they become
  # WAV 16-bit, 48 kHz (PipeWire's own rate), mono, without silence at the start or at the end.
  mkdir -p build/sounds
  local wav
  for wav in frontend/sounds/*.wav; do
    ffmpeg -v error -y -i "$wav" -af "silenceremove=start_periods=1:start_threshold=-60dB,areverse,silenceremove=start_periods=1:start_threshold=-60dB,areverse" \
      -ac 1 -ar 48000 -c:a pcm_s16le "build/sounds/${wav##*/}"
  done
  # One second of silence, looped by the interface to keep the sound output running
  ffmpeg -v error -y -f lavfi -i anullsrc=r=48000:cl=mono -t 1 -c:a pcm_s16le build/sounds/silence.wav
}

check() {
  # No display in the build chroot: offscreen platform and Qt Quick's software renderer.
  # test_Playtime is left out: it fails now and then upstream too.
  cd build
  QT_QPA_PLATFORM=offscreen QT_QUICK_BACKEND=software ctest --output-on-failure -E 'test_Playtime'

  # The theme loads without a QML warning. Some mistakes only show when the theme is loaded, not
  # in the build: e.g. a property named like one of Item's own ("Cannot override FINAL
  # property", 2026-10-17), after which the console cannot show its interface. The interface
  # runs for 15 s without a screen, in an empty home folder.
  local home status=0
  home="$(mktemp -d)"
  HOME="$home" XDG_CONFIG_HOME="$home/.config" XDG_DATA_HOME="$home/.local/share" \
    QT_QPA_PLATFORM=offscreen QT_QUICK_BACKEND=software \
    timeout 15 src/app/owneet-frontend > "$home/run.log" 2>&1 || status=$?
  if grep -F 'qrc:/themes/' "$home/run.log"; then
    echo "error: the theme gives the QML warnings above" >&2
    return 1
  fi
  if (( status != 124 )) || ! grep -q 'Theme set to' "$home/run.log"; then
    cat "$home/run.log" >&2
    echo "error: the interface did not load its theme and keep running (exit status $status)" >&2
    return 1
  fi
  rm -rf "$home"
}

package() {
  # Only the executable: Pegasus's icons, desktop file and documents are not installed
  # (Pegasus's licence: a modified version does not use its name or logos).
  install -Dm755 build/src/app/owneet-frontend "$pkgdir/usr/bin/owneet-frontend"
  # Interface translations (docs/translating.md)
  install -Dm644 -t "$pkgdir/usr/share/owneet-frontend/i18n" frontend/i18n/*.json
  # Interface sounds (3.12): the owner's (GPL-3.0-or-later) and Kenney's placeholders (CC0)
  install -Dm644 -t "$pkgdir/usr/share/owneet-frontend/sounds" build/sounds/*.wav
  local src=frontend/owneet-frontend lic="$pkgdir/usr/share/licenses/$pkgname"
  install -Dm644 "$src/LICENSE.md" "$lic/LICENSE.md"
  install -Dm644 "$src/thirdparty/SortFilterProxyModel/LICENSE" "$lic/LICENSE.SortFilterProxyModel"
  install -Dm644 "$src/assets/fonts/owneet/OFL-BricolageGrotesque.txt" "$lic/OFL-BricolageGrotesque.txt"
  install -Dm644 "$src/assets/fonts/owneet/OFL-Lexend.txt" "$lic/OFL-Lexend.txt"
  install -Dm644 frontend/sounds/LICENSE-Kenney.txt "$lic/LICENSE-Kenney-sounds.txt"
  install -Dm644 frontend/sounds/SOURCES.md "$lic/SOURCES-sounds.md"
}
