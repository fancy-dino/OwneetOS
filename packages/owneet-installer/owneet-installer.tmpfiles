# Where the console writes its installation request (owneet-install, read as plain text by root)
d /run/owneet-install 0755 owneet owneet -
# Where the console writes its request to prepare a disk for games (owneet-prepare-disk)
d /run/owneet-prepare 0755 owneet owneet -
