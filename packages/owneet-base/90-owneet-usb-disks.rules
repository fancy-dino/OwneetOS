# SPDX-License-Identifier: GPL-3.0-or-later
# Minimal mounting of USB disks ([[step-4.3-local-drm-free-games]]): a file system on a USB disk
# starts owneet-mount-ro@<kernel name>.service, which mounts it read only under /run/media/owneet.
# Not the OWNEETLOG stick (owneet-testlog, owneet-update), not EFI system partitions (e.g. the
# installation stick's), only file systems the console can read. Internal disks: step 6.5.
ACTION=="remove", GOTO="owneet_usb_disks_end"
SUBSYSTEM!="block", GOTO="owneet_usb_disks_end"
ENV{ID_BUS}!="usb", GOTO="owneet_usb_disks_end"
ENV{ID_FS_USAGE}!="filesystem", GOTO="owneet_usb_disks_end"
ENV{ID_FS_LABEL}=="OWNEETLOG", GOTO="owneet_usb_disks_end"
ENV{ID_PART_ENTRY_TYPE}=="c12a7328-f81f-11d2-ba4b-00a0c93ec93b|0xef", GOTO="owneet_usb_disks_end"
ENV{ID_FS_TYPE}=="ext2|ext3|ext4|btrfs|xfs|vfat|exfat|ntfs", TAG+="systemd", ENV{SYSTEMD_WANTS}+="owneet-mount-ro@%k.service"
LABEL="owneet_usb_disks_end"
