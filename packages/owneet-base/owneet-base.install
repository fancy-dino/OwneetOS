# The system's locales (C.UTF-8 is built in): English, which Steam needs (otherwise it builds
# the locale again at every start, in its container), and the interface's languages
_owneet_locales() {
  local l
  for l in en_US it_IT; do
    if ! locale -a 2>/dev/null | grep -qx "$l.utf8"; then
      localedef -i "$l" -c -f UTF-8 -A /usr/share/locale/locale.alias "$l.UTF-8" >/dev/null 2>&1 || true
    fi
  done
}

post_install() {
  systemctl preset owneet-diagnostics.service owneet-testlog.service owneet-tester-install.service owneet-update-boot.service >/dev/null 2>&1 || true
  _owneet_locales
}

post_upgrade() {
  post_install
  # Systems installed by owneet-tester-install before 0.0.27: the "Fallback Linux Boot Manager"
  # entry pointed to a file that did not exist (the only entry some firmware offers)
  local sdboot=/boot/EFI/systemd
  if [[ -f /etc/owneet/tester && -f $sdboot/systemd-bootx64.efi && ! -f $sdboot/systemd-boot-fallbackx64.efi ]]; then
    cp $sdboot/systemd-bootx64.efi $sdboot/systemd-boot-fallbackx64.efi || true
  fi
}
