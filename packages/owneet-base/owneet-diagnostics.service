# Runs only when the system is started from the diagnostics boot entry (owneet.diagnostics).
[Unit]
Description=OwneetOS diagnostics report on tty9
ConditionKernelCommandLine=owneet.diagnostics
After=getty@tty1.service

[Service]
Type=simple
ExecStart=/usr/lib/owneet/owneet-diagnostics
StandardInput=tty
StandardOutput=tty
TTYPath=/dev/tty9
TTYReset=yes
TTYVHangup=yes
# The interactive root shell left open at the end ignores SIGTERM: without this, shutting down
# waits 90 s for it.
KillSignal=SIGHUP
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target
