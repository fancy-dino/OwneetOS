// Optional apps ([[step-5.0.0-optional-web-apps]]): owneetd (the console user) installs and
// removes the engines of the web apps from the bundled repository. Only these two unit templates,
// only start, only the console user in the active local session; owneet-apps itself accepts only
// the engines of /usr/share/owneet/apps.json.
polkit.addRule(function (action, subject) {
    if (action.id === "org.freedesktop.systemd1.manage-units" &&
            subject.user === "owneet" && subject.local && subject.active &&
            /^owneet-apps-(install|remove)@[a-z0-9-]+\.service$/.test(action.lookup("unit")) &&
            action.lookup("verb") === "start") {
        return polkit.Result.YES;
    }
});
