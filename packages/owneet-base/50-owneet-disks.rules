// Settings → Disks (owneetd, the console user) prepares for games the disk the player chose, named and
// confirmed ([[step-6.7-preparing-other-disks]]). Only this unit, only start, only the console user in
// the active local session; the unit runs only on the installed console and checks the request again.
polkit.addRule(function (action, subject) {
    if (action.id === "org.freedesktop.systemd1.manage-units" &&
            subject.user === "owneet" && subject.local && subject.active &&
            action.lookup("unit") === "owneet-prepare-disk.service" &&
            action.lookup("verb") === "start") {
        return polkit.Result.YES;
    }
});
