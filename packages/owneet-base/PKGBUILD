pkgname=owneet-base
pkgver=0.0.52
pkgrel=1
pkgdesc="OwneetOS base system: release information and the packages every OwneetOS system needs"
arch=('any')
url="https://github.com/fancy-dino/OwneetOS"
license=('GPL-3.0-or-later')
depends=('base' 'owneet-keyring' 'owneet-session' 'owneet-branding' 'owneet-hardware' 'owneetd'
         'owneet-frontend'
         # Steam ([multilib]; its runtime is downloaded by Steam on first launch)
         'steam'
         # Windows games: umu-launcher ([multilib]) runs them with Proton, which it downloads once
         # with its runtime ([[step-4.5-windows-games-proton]]; owneetd and owneet-windows-run)
         'umu-launcher'
         # GOG's DOS games: DOSBox Staging (built by OwneetOS, packages/dosbox-staging) instead of
         # the Windows DOSBox GOG ships (owneet-dos-run)
         'dosbox-staging'
         # the installed system's file systems (btrfs root, FAT32 boot partition)
         'btrfs-progs' 'dosfstools')
install=owneet-base.install
# owneet-base-src.tar.gz is generated by tools/build-packages from the files in source-dirs
# (CREDITS.md and the browser extension, extension/, at the root of the repository).
source=('owneet-base-src.tar.gz' 'owneet-release' 'owneet-diagnostics' 'owneet-diagnostics.service' '50-owneet-base.preset'
        'owneet-testlog' 'owneet-testlog.service' 'owneet-tester-install' 'owneet-tester-install.service'
        'getty-tty1-tester-install.conf' 'owneet-update' 'owneet-update@.service'
        'owneet-update-boot.service' '50-owneet-update.rules' 'apps.json' 'owneet-apps'
        'owneet-apps-install@.service' 'owneet-apps-remove@.service' '50-owneet-apps.rules'
        'brave-policies.json' 'owneet-mount-ro' 'owneet-mount-ro@.service' '90-owneet-usb-disks.rules')
sha256sums=('SKIP'
