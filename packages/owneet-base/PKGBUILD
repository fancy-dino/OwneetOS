package() {
  install -Dm644 owneet-release "$pkgdir/usr/share/owneet/owneet-release"
  install -Dm755 owneet-diagnostics "$pkgdir/usr/lib/owneet/owneet-diagnostics"
  install -Dm644 owneet-diagnostics.service "$pkgdir/usr/lib/systemd/system/owneet-diagnostics.service"
  # Testers only ([[step-7.4-hardware-testing-and-v0.1.0]]): log to a USB stick labelled OWNEETLOG
  install -Dm755 owneet-testlog "$pkgdir/usr/lib/owneet/owneet-testlog"
  install -Dm644 owneet-testlog.service "$pkgdir/usr/lib/systemd/system/owneet-testlog.service"
  install -Dm755 owneet-tester-install "$pkgdir/usr/lib/owneet/owneet-tester-install"
  install -Dm644 owneet-tester-install.service "$pkgdir/usr/lib/systemd/system/owneet-tester-install.service"
  install -Dm644 getty-tty1-tester-install.conf \
    "$pkgdir/usr/lib/systemd/system/getty@tty1.service.d/owneet-tester-install.conf"
  install -Dm755 owneet-update "$pkgdir/usr/lib/owneet/owneet-update"
  install -Dm644 owneet-update@.service owneet-update-boot.service -t "$pkgdir/usr/lib/systemd/system/"
  install -Dm644 50-owneet-update.rules "$pkgdir/usr/share/polkit-1/rules.d/50-owneet-update.rules"
  # Optional apps ([[step-5.0.0-optional-web-apps]]): the catalogue and the root helper that
  # installs the engines from the ISO's bundled repository
  install -Dm644 apps.json "$pkgdir/usr/share/owneet/apps.json"
  install -Dm755 owneet-apps "$pkgdir/usr/lib/owneet/owneet-apps"
  install -Dm644 owneet-apps-install@.service owneet-apps-remove@.service -t "$pkgdir/usr/lib/systemd/system/"
  install -Dm644 50-owneet-apps.rules "$pkgdir/usr/share/polkit-1/rules.d/50-owneet-apps.rules"
  # Brave in the OS ([[step-5.1-brave-in-the-os]]): managed policies that lock its settings (no
  # telemetry, no Rewards / Wallet / VPN / AI chat, no sign-in or sync, no downloads or printing,
  # no password or address saving, whose windows need a mouse: [[step-5.5-spotify]]; no tabs of
  # the session before; internal pages blocked); harmless while Brave is not installed. owneetd loads the console's
  # extension from /usr/share/owneet/extension when it opens a web app (no store, no update server).
  install -Dm644 brave-policies.json "$pkgdir/etc/brave/policies/managed/owneet.json"
  # A used profile gets a changed worker only with a new version AND a new file name
  # ([[brave-extension-worker-cached]]): the worker is named after its content, and the manifest's
  # version is this package's (new with every release)
  local ext="$pkgdir/usr/share/owneet/extension"
  local worker="background-$(sha256sum extension/background.js | cut -c1-12).js"
  local version="$pkgver.$pkgrel"
  [[ "$version" =~ ^[0-9]+(\.[0-9]+){0,3}$ ]] || { echo "error: $version is not a valid extension version" >&2; return 1; }
  install -Dm644 extension/background.js "$ext/$worker"
  sed -e "s|\"service_worker\": \"background.js\"|\"service_worker\": \"$worker\"|" \
      -e "s|\"version\": \"[^\"]*\"|\"version\": \"$version\"|" extension/manifest.json > manifest.installed.json
  install -Dm644 manifest.installed.json "$ext/manifest.json"
  if ! grep -q "\"service_worker\": \"$worker\"" "$ext/manifest.json" || [[ ! -f "$ext/$worker" ]] \
      || ! grep -q "\"version\": \"$version\"" "$ext/manifest.json"; then
    echo "error: the installed manifest.json does not name the worker $worker with version $version" >&2
    return 1
  fi
  install -Dm644 extension/content/*.js -t "$ext/content/"
  # USB disks mounted read only for the games on them ([[step-4.3-local-drm-free-games]])
  install -Dm755 owneet-mount-ro "$pkgdir/usr/lib/owneet/owneet-mount-ro"
  install -Dm644 owneet-mount-ro@.service -t "$pkgdir/usr/lib/systemd/system/"
  install -Dm644 90-owneet-usb-disks.rules "$pkgdir/usr/lib/udev/rules.d/90-owneet-usb-disks.rules"
  install -Dm644 50-owneet-base.preset "$pkgdir/usr/lib/systemd/system-preset/50-owneet-base.preset"
  install -Dm644 CREDITS.md "$pkgdir/usr/share/doc/owneetos/CREDITS.md"
}
