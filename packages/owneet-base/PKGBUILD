pkgname=owneet-base
pkgver=0.0.27
pkgrel=1
pkgdesc="OwneetOS base system: release information and the packages every OwneetOS system needs"
arch=('any')
url="https://github.com/fancy-dino/OwneetOS"
license=('GPL-3.0-or-later')
depends=('base' 'owneet-keyring' 'owneet-session' 'owneet-branding' 'owneet-hardware' 'owneetd'
         'owneet-frontend'
         # Steam ([multilib]; its runtime is downloaded by Steam on first launch)
         'steam'
         # the installed system's file systems (btrfs root, FAT32 boot partition)
         'btrfs-progs' 'dosfstools')
install=owneet-base.install
# owneet-base-src.tar.gz is generated by tools/build-packages from the files in source-dirs
# (CREDITS.md at the root of the repository).
source=('owneet-base-src.tar.gz' 'owneet-release' 'owneet-diagnostics' 'owneet-diagnostics.service' '50-owneet-base.preset'
        'owneet-testlog' 'owneet-testlog.service' 'owneet-tester-install' 'owneet-tester-install.service'
        'getty-tty1-tester-install.conf' 'owneet-update' 'owneet-update@.service'
        'owneet-update-boot.service' '50-owneet-update.rules')
sha256sums=('SKIP'
            '74f473c3e5cec980798421ac667c84f3938a1e93160b37112300a25aa2ea0400'
            'e739678148442c4770b5c7cf793df180bc475cd33cf1bcb347affdb978f84fc3'
            'dfcdb91edaa6fd46121f8f3a2ce95b0a8e461c5f04c6f9325a1babe45e53cdea'
            '471544b748df8fd99f6ec426784a1c389ae9db8f829ef392fda862bd91cc4f49'
            '814e86bbecc0592aea5cdbf98a328d21d05c8d157d4ff3b52ed4f6ccd7f584f0'
            '21a26bf30666c8897ec0425f967e0a415352e22a92ba3a243e0d57fca3e55a9b'
            '5619af6ca53f36204715895ad444ab335a2ab0e38c281e25fe8a0dd8e3ff93f4'
            '9aa02524ad29c812ce67973e7f01c811b7e559a5ace44ad5e4418db58373b001'
            '999400330a130b34052529fd8ed5b0dc96b4e205b2b37f885aa8c8ee349a6b0e'
            '5968d2b28a2a25b27a33fb248eb98fdf4dfde7cea8448fe04803e1490681e963'
