pkgname=owneet-base
pkgver=0.0.9
pkgrel=1
pkgdesc="OwneetOS base system: release information and the packages every OwneetOS system needs"
arch=('any')
url="https://github.com/fancy-dino/OwneetOS"
license=('GPL-3.0-or-later')
depends=('base' 'owneet-keyring' 'owneet-session' 'owneet-branding' 'owneet-hardware' 'owneetd')
install=owneet-base.install
source=('owneet-release' 'owneet-diagnostics' 'owneet-diagnostics.service' '50-owneet-base.preset')
sha256sums=('74f473c3e5cec980798421ac667c84f3938a1e93160b37112300a25aa2ea0400'
            'f0dffda7507753e795a54b1a204adf2a1d8b3fb87dc4e892c81a79f1c6bfaf6f'
            'dfcdb91edaa6fd46121f8f3a2ce95b0a8e461c5f04c6f9325a1babe45e53cdea'
            '9d4565c8345f6e84c8a7667f7174e8b2c7e5e9f55d30122084f3fa97f95c05fc')

package() {
  install -Dm644 owneet-release "$pkgdir/usr/share/owneet/owneet-release"
  install -Dm755 owneet-diagnostics "$pkgdir/usr/lib/owneet/owneet-diagnostics"
  install -Dm644 owneet-diagnostics.service "$pkgdir/usr/lib/systemd/system/owneet-diagnostics.service"
  install -Dm644 50-owneet-base.preset "$pkgdir/usr/lib/systemd/system-preset/50-owneet-base.preset"
}
