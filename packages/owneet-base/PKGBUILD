package() {
  install -Dm644 owneet-release "$pkgdir/usr/share/owneet/owneet-release"
  install -Dm755 owneet-diagnostics "$pkgdir/usr/lib/owneet/owneet-diagnostics"
  install -Dm644 owneet-diagnostics.service "$pkgdir/usr/lib/systemd/system/owneet-diagnostics.service"
  # Testers only (roadmap 7.4): log to a USB stick labelled OWNEETLOG
  install -Dm755 owneet-testlog "$pkgdir/usr/lib/owneet/owneet-testlog"
  install -Dm644 owneet-testlog.service "$pkgdir/usr/lib/systemd/system/owneet-testlog.service"
  install -Dm755 owneet-tester-install "$pkgdir/usr/lib/owneet/owneet-tester-install"
  install -Dm644 owneet-tester-install.service "$pkgdir/usr/lib/systemd/system/owneet-tester-install.service"
  install -Dm644 getty-tty1-tester-install.conf \
    "$pkgdir/usr/lib/systemd/system/getty@tty1.service.d/owneet-tester-install.conf"
  install -Dm755 owneet-update "$pkgdir/usr/lib/owneet/owneet-update"
  install -Dm644 owneet-update@.service owneet-update-boot.service -t "$pkgdir/usr/lib/systemd/system/"
  install -Dm644 50-owneet-update.rules "$pkgdir/usr/share/polkit-1/rules.d/50-owneet-update.rules"
  install -Dm644 50-owneet-base.preset "$pkgdir/usr/lib/systemd/system-preset/50-owneet-base.preset"
  install -Dm644 CREDITS.md "$pkgdir/usr/share/doc/owneetos/CREDITS.md"
}
