#!/bin/bash
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Testers only (leaves the user ISO with the test boot entries,
# [[step-7.4-hardware-testing-and-v0.1.0]]). When a USB stick with a partition labelled OWNEETLOG
# (FAT32 or exFAT) is plugged in at boot, the system log and a hardware report (every 10 s) are
# written there while the system runs, so that they survive a forced power-off; Steam's own logs too
# (they name the tester's Steam account: the stick is theirs). Nothing happens without that stick.
#
# Without it, in the live system only: a smaller log on the OwneetOS USB stick itself, in its FAT
# boot partition (ARCHISO_EFI, about 7 MB free; the boot files are never touched, files are only
# added): the system log up to 4 MB, the report and the windows up to 1 MB each, no Steam logs.
# For testers with a single USB stick (2026-10-17).

set -u

dev=/dev/disk/by-label/OWNEETLOG
for _ in $(seq 1 60); do [[ -e "$dev" ]] && break; sleep 1; done
small=0
if [[ ! -e "$dev" ]]; then
    dev=/dev/disk/by-label/ARCHISO_EFI
    [[ -d /run/archiso && -e "$dev" ]] || exit 0
    small=1
fi

mnt=/run/owneet-testlog
mkdir -p "$mnt"
mount -o sync,noatime,uid=0,gid=0,umask=022 "$dev" "$mnt" || exit 1
base="$mnt/owneet-$(date +%Y%m%d-%H%M%S)"

owneetd_get() {
    local uid
    uid="$(id -u owneet)"
    runuser -u owneet -- env XDG_RUNTIME_DIR="/run/user/$uid" owneetctl get "$1" 2>&1
}

report() {
    echo "===== $(date '+%F %T') ($(. /etc/os-release; echo "${IMAGE_VERSION:-unknown}"), kernel $(uname -r))"
    echo "--- kernel command line"; cat /proc/cmdline
    echo "--- owneet-debug.txt (tester switches)"; cat "$mnt/owneet-debug.txt" 2>/dev/null
    echo "--- GPUs"; lspci -nnk | grep -iA3 -E 'vga|3d|display'
    echo "--- cards"
    for c in /sys/class/drm/card[0-9]; do
        echo "$(basename "$c") $(cat "$c/device/vendor" 2>/dev/null):$(cat "$c/device/device" 2>/dev/null) driver=$(basename "$(readlink "$c/device/driver")")"
    done
    echo "--- connectors (status, enabled, dpms)"
    for c in /sys/class/drm/card[0-9]-*; do
        echo "$(basename "$c") $(cat "$c/status") $(cat "$c/enabled") $(cat "$c/dpms")"
    done
    echo "--- monitor modes (the kernel's list, the first preferred; the EDID's own timings with their refresh)"
    for c in /sys/class/drm/card[0-9]-*; do
        [[ "$(cat "$c/status" 2>/dev/null)" == connected ]] || continue
        echo "$(basename "$c"): $(paste -sd' ' "$c/modes" 2>/dev/null)"
        # the detailed timings of the EDID (base block): the first is the monitor's preferred mode
        python3 -I - "$c/edid" <<'PY' 2>/dev/null
import sys
e = open(sys.argv[1], "rb").read()
for i in range(4):
    d = e[54 + 18 * i:72 + 18 * i]
    clock = int.from_bytes(d[0:2], "little") * 10000
    if len(d) < 18 or clock == 0:
        continue
    ha, hb = d[2] | (d[4] & 0xF0) << 4, d[3] | (d[4] & 0x0F) << 8
    va, vb = d[5] | (d[7] & 0xF0) << 4, d[6] | (d[7] & 0x0F) << 8
    print("  EDID timing %d: %dx%d @ %.2f Hz" % (i + 1, ha, va, clock / ((ha + hb) * (va + vb))))
PY
    done
    echo "--- gamescope's devices"
    for p in $(pgrep -x gamescope-wl); do
        for fd in "/proc/$p/fd/"*; do readlink "$fd"; done | grep '^/dev/dri/' | sort -u | paste -sd' '
    done
    echo "--- display.conf"; cat /home/owneet/.config/owneet/display.conf* 2>/dev/null
    echo "--- owneet-screens-off"; systemctl list-units --all --no-pager --plain 'owneet-screens-off@*' | head -5
    echo "--- /v1/display"; owneetd_get /v1/display
    echo "--- /v1/status"; owneetd_get /v1/status
    echo "--- /v1/apps"; owneetd_get /v1/apps
    echo "--- /v1/steam"; owneetd_get /v1/steam
    echo "--- disks (games on a USB disk, 4.3)"
    lsblk -o NAME,TRAN,FSTYPE,LABEL,SIZE,RO,MOUNTPOINTS 2>&1
    systemctl list-units --all --no-pager --plain 'owneet-mount@*' 2>&1 | head -8
    # each disk's room, in bytes: what a move, an uninstall or a deletion freed (2026-11-11: the
    # library rounds a 2 TB disk's free space to 0.1 TB)
    echo "--- disks' room (bytes)"; df -B1 --output=target,size,used,avail / /home /run/media/owneet/* 2>/dev/null
    # Reads and writes of each disk, the data waiting in memory to be written, and a copy between
    # disks (6.6): a copy that seems stuck shows which disk holds it back (2026-11-10: a 2 TB SMR disk
    # slowed down to about 0.5 MB/s after a few GB, the USB disk it read from stayed idle)
    echo "--- disk reads and writes (sectors read, ms reading, sectors written, ms writing)"
    awk '$3 ~ /^(sd[a-z]+|nvme[0-9]+n[0-9]+)$/ { print $3, $6, $7, $10, $11 }' /proc/diskstats
    echo "--- memory waiting to be written (kB)"; grep -E '^(Dirty|Writeback):' /proc/meminfo
    echo "--- /v1/moves"; owneetd_get /v1/moves
    # A game that does not show up (e.g. CAYNE, 4.3): what its processes are doing
    echo "--- the console user's busiest processes"
    ps -u owneet -o pid,stat,pcpu,rss,etime,wchan:24,args --sort=-pcpu 2>&1 | cut -c1-200 | head -12
    # Steam's controller settings only (Steam Input; step 4.2c bugs): config.vdf also holds
    # sign-in data, which never leaves the PC, so only these lines are copied
    echo "--- Steam controller settings"
    grep -H -i -E '"[^"]*(steamcontroller|steaminput|usesteamcontrollerconfig|xboxsupport|pssupport|switchsupport|genericgamepad|gamepad)[^"]*"[[:space:]]+"[^"]*"' \
        /home/owneet/.local/share/Steam/config/*.vdf \
        /home/owneet/.local/share/Steam/userdata/*/config/*.vdf \
        /home/owneet/.steam/registry.vdf 2>/dev/null | sed 's|^/home/owneet/||' | sort | uniq -c | head -80
}

# Steam's logs (launches, Proton, downloads; its interface's pages: cef_log, webhelper; its
# controller handling: controller), copied as they grow
steam_logs() {
    local logs=/home/owneet/.local/share/Steam/logs
    [[ -d "$logs" ]] || return 0
    mkdir -p "$base.steam"
    for f in console_log.txt compat_log.txt content_log.txt bootstrap_log.txt shader_log.txt \
             cef_log.txt webhelper.txt controller.txt controller_ui.txt; do
        [[ -f "$logs/$f" ]] && cp -u "$logs/$f" "$base.steam/" 2>/dev/null
    done
}

# The logs games on a disk write about themselves (4.3): Unity's Player.log (engine, graphics,
# errors), written during this boot
game_logs() {
    local f name
    for f in /home/owneet/.config/unity3d/*/*/Player.log; do
        [[ -f "$f" && "$f" -nt /proc/1 ]] || continue
        mkdir -p "$base.games"
        name="$(basename "$(dirname "$f")")"
        name="${name//[^A-Za-z0-9._-]/_}"
        cp -u "$f" "$base.games/unity-$name.log" 2>/dev/null
    done
    # Windows games with owneet.debug.windows_log=on (4.5): Proton's logs, one folder per game
    for f in /home/owneet/.local/share/owneet/windows/logs/*/*.log; do
        [[ -f "$f" && "$f" -nt /proc/1 ]] || continue
        mkdir -p "$base.games"
        name="$(basename "$(dirname "$f")")-$(basename "$f")"
        cp -u "$f" "$base.games/windows-${name//[^A-Za-z0-9._-]/_}" 2>/dev/null
    done
}

# The whole system log, as it is written (capped on the OwneetOS stick itself)
if (( small )); then
    journalctl -b -f -n all -o short-precise 2>&1 | head -c 4000000 > "$base.journal.txt" &
else
    journalctl -b -f -n all -o short-precise > "$base.journal.txt" 2>&1 &
fi
journal=$!
# (and the disks' listing, if still running)
trap 'kill "$journal" $(jobs -p) 2>/dev/null; sync; umount "$mnt"; exit 0' TERM INT

report > "$base.report.txt" 2>&1
# The end of the previous start's journal (kept on the disk): how the last power-off went, after the
# logs on the stick had stopped (the way from the home screen to "Shutting down", 2026-11-09)
{ echo "--- the previous power-off (end of the previous start's journal)"
  journalctl -b -1 -n 300 -o short-precise --no-pager 2>&1; } >> "$base.report.txt"
# The whole journals of the five previous starts (kept on the console's disk), compressed: a test
# made without the stick can still be read (2026-11-11: an install failed before the stick was in;
# 2026-11-13: five, a game folder doubled some starts before the stick was in)
if (( ! small )); then
    mkdir -p "$base.previous"
    for b in 1 2 3 4 5; do
        journalctl -b -$b -o short-precise --no-pager 2>&1 | gzip > "$base.previous/boot-minus-$b.txt.gz"
    done
    journalctl --list-boots --no-pager > "$base.previous/boots.txt" 2>&1
fi
# Once the console has started: the monitors seen by ddcutil, then a report every 10 s
sleep 60
# The console's own disk: its room and what takes it (2026-11-10: about 23 GB went in a day; a game
# installed on it). Once per start: measuring the folders takes a while.
{ echo "--- the console's disk: room, and the biggest folders"
  df -h / /home 2>&1
  du -xsh /home/owneet/Giochi /home/owneet/Games /home/owneet/.local/share/Steam /home/owneet/.local/share/owneet/windows \
      /home/owneet/.local/share/umu /home/owneet/.cache /var/cache/pacman/pkg /var/log 2>/dev/null
  echo "- the biggest folders in the console user's home"
  du -xh -d3 /home/owneet 2>/dev/null | sort -h | tail -20
  echo "- btrfs: subvolumes and space"
  btrfs subvolume list / 2>&1 | head -20
  timeout 120 btrfs filesystem du -s /.snapshots/* 2>&1 | head -12
  btrfs filesystem usage -T / 2>&1 | head -16; } >> "$base.report.txt"
# The whole content of every disk, once per start (owner, 2026-11-11: no junk files may stay, the
# disks must not fill up over time; [[open-items]] 3p): one line per file, folder or link (type,
# bytes, date, path), compressed, one file per disk in $base.files. The console's disk is read
# subvolume by subvolume as mounted (/, /home, /var/log, the packages); its snapshots are only
# measured above. Behind everything else, at the lowest priority; each listing is made in memory
# and copied to the stick once whole (the stick is mounted "sync": writing it bit by bit took
# minutes, and a power-off left a cut listing, 2026-11-11).
disk_files() {
    local src m name tmp
    renice -n 19 -p "$BASHPID" >/dev/null 2>&1
    ionice -c 3 -p "$BASHPID" >/dev/null 2>&1
    tmp="$(mktemp -d /run/owneet-testlog-files.XXXXXX)" || return
    mkdir -p "$base.files"
    list() {
        { df -B1 "$1"; find "$1" -xdev -printf '%y\t%s\t%TY-%Tm-%Td %TH:%TM\t%p\n' 2>&1; } | gzip > "$tmp/$2.txt.gz" \
            && cp "$tmp/$2.txt.gz" "$base.files/" && sync
        rm -f "$tmp/$2.txt.gz"
    }
    src="$(findmnt -n -o SOURCE / | sed 's/\[.*//')"
    while read -r m; do
        [[ "$m" == /.snapshots || "$m" == /.snapshots/* ]] && continue
        name="console${m//\//-}"
        [[ "$m" == / ]] && name=console-root
        list "$m" "$name"
    done < <(findmnt -n -l -o TARGET --source "$src")
    for m in /run/media/owneet/*; do
        mountpoint -q "$m" || continue
        list "$m" "disk-$(basename "$m" | tr -c 'A-Za-z0-9._\n-' '_')"
    done
    rmdir "$tmp"
    echo "done $(date '+%F %T')" > "$base.files/complete.txt"
}
(( small )) || disk_files &
# The libraries the Linux games' programs miss, once per start (2026-11-11: The Witcher 2's GOG
# launcher needs 32-bit GTK 2, which the system does not have, and the game ended at once): each
# program (ELF) up to four folders deep in a games folder, its class and what ldd does not find,
# read as the console user
linux_games_libs() {
    local dir f class
    echo "--- Linux games: programs and the libraries they miss"
    for dir in /home/owneet/[Gg]ames /home/owneet/[Gg]iochi /run/media/owneet/*/[Gg]ames /run/media/owneet/*/[Gg]iochi; do
        [[ -d "$dir" ]] || continue
        find "$dir" -mindepth 2 -maxdepth 5 -type f -perm -u+x -size +1k 2>/dev/null | head -400 | while IFS= read -r f; do
            [[ "$(od -An -tx1 -N4 "$f" 2>/dev/null | tr -d ' \n')" == 7f454c46 ]] || continue
            class="$(od -An -tu1 -j4 -N1 "$f" 2>/dev/null | tr -d ' ')"
            echo "$f ($([[ "$class" == 1 ]] && echo 32 || echo 64)-bit)"
            runuser -u owneet -- timeout 10 ldd "$f" 2>&1 | grep -E 'not found|not a dynamic' | sed 's/^/    /'
        done
    done
}
(( small )) || linux_games_libs >> "$base.report.txt" 2>&1
# How the Linux games start, once per start (2026-11-11: The Witcher 2's launcher for the TV ended
# at once, "basic_string::_S_construct null not valid"): a copy of each game's small scripts (the
# chain of launchers, the variables they set) in $base.games/linux-<game>, and the names that look
# like environment variables inside its programs called *launcher* (what they may expect from Steam)
linux_games_scripts() {
    local dir game f out
    for dir in /home/owneet/[Gg]ames /home/owneet/[Gg]iochi /run/media/owneet/*/[Gg]ames /run/media/owneet/*/[Gg]iochi; do
        [[ -d "$dir" ]] || continue
        for game in "$dir"/*/; do
            out="$base.games/linux-$(basename "$game" | tr -c 'A-Za-z0-9._\n-' '_')"
            find "$game" -maxdepth 3 -type f -size -16k \( -name '*.sh' -o -perm -u+x -o -name gameinfo \) 2>/dev/null \
                | head -40 | while IFS= read -r f; do
                    [[ "$(od -An -tx1 -N4 "$f" 2>/dev/null | tr -d ' \n')" == 7f454c46 ]] && continue
                    mkdir -p "$out"
                    cp "$f" "$out/$(realpath --relative-to="$game" "$f" | tr '/' '_')" 2>/dev/null
                done
            find "$game" -maxdepth 3 -type f -iname '*launcher*' -size +1k 2>/dev/null | head -8 | while IFS= read -r f; do
                [[ "$(od -An -tx1 -N4 "$f" 2>/dev/null | tr -d ' \n')" == 7f454c46 ]] || continue
                mkdir -p "$out"
                grep -aoE '(Steam[A-Za-z_]+|[A-Z][A-Z0-9]*_[A-Z0-9_]+|[A-Z]{4,})' "$f" 2>/dev/null | sort -u | head -300 \
                    > "$out/names-in-$(basename "$f").txt"
            done
        done
    done
}
(( small )) || linux_games_scripts
# The games folders, once per start (owner, 2026-11-13: a game's folder doubled, one name with ":"
# and one with " - "): on every disk, each game folder as its name really is, its size and date,
# what is at its top, and the files the console writes or reads there (the install marks, game.txt,
# GOG's gameinfo), whole
games_folders() {
    local dir game f
    echo "--- games folders: each one, its top, the console's own files in it"
    for dir in /home/owneet/[Gg]ames /home/owneet/[Gg]iochi /run/media/owneet/*/[Gg]ames /run/media/owneet/*/[Gg]iochi; do
        [[ -d "$dir" ]] || continue
        for game in "$dir"/*/; do
            game="${game%/}"
            echo "== [$game] $(du -sb "$game" 2>/dev/null | cut -f1) bytes, $(find "$game" -type f 2>/dev/null | wc -l) files, $(stat -c '%y %U' "$game" 2>/dev/null)"
            find "$game" -mindepth 1 -maxdepth 1 -printf '   %y %10s %TY-%Tm-%Td %TH:%TM  %f\n' 2>/dev/null | sort -k5
            for f in "$game"/.owneet-installing "$game"/.owneet-installed "$game"/game.txt "$game"/gameinfo; do
                [[ -f "$f" ]] || continue
                echo "   --- $(basename "$f") ($(stat -c '%s bytes, %y' "$f"))"
                head -c 4000 "$f" | sed 's/^/      /'
                echo
            done
        done
    done
    echo "--- the files the user chose to start (~/.config/owneet-frontend/disk-games.json)"
    cat /home/owneet/.config/owneet-frontend/disk-games.json 2>&1; echo
    echo "--- owneetd's installs (/v1/installs)"; owneetd_get /v1/installs
}
(( small )) || games_folders >> "$base.report.txt" 2>&1
# Everything named after The Witcher 2 on every disk, once per start (owner, 2026-11-13: its folder
# doubled after a download made without the stick): each folder (its size, files, date and top) and
# each file (size, date) whose name has "witcher", with the console's own files in such folders
witcher_folders() {
    local d f
    echo "--- everything named after The Witcher 2 (folders and files whose name has \"witcher\")"
    # each disk on its own (-xdev from /run/media/owneet did not enter them, 2026-11-13)
    local roots=(/home/owneet) m
    for m in /run/media/owneet/*; do mountpoint -q "$m" && roots+=("$m"); done
    find "${roots[@]}" -xdev -maxdepth 7 -iname '*witcher*' -type d 2>/dev/null | sort | while IFS= read -r d; do
        echo "== [$d] $(du -sb "$d" 2>/dev/null | cut -f1) bytes, $(find "$d" -type f 2>/dev/null | wc -l) files, $(stat -c '%y %U' "$d" 2>/dev/null)"
        find "$d" -mindepth 1 -maxdepth 1 -printf '   %y %12s %TY-%Tm-%Td %TH:%TM  %f\n' 2>/dev/null | sort -k5
        for f in "$d"/.owneet-installing "$d"/.owneet-installed "$d"/game.txt "$d"/gameinfo; do
            [[ -f "$f" ]] || continue
            echo "   --- $(basename "$f") ($(stat -c '%s bytes, %y' "$f"))"
            head -c 4000 "$f" | sed 's/^/      /'
            echo
        done
    done
    echo "- files"
    find "${roots[@]}" -xdev -maxdepth 7 -iname '*witcher*' -type f -printf '%12s %TY-%Tm-%Td %TH:%TM  %p\n' 2>/dev/null \
        | grep -v '/[^/]*[Ww]itcher[^/]*/.*/' | sort -k4 | head -200
}
(( small )) || witcher_folders >> "$base.report.txt" 2>&1
{ echo "--- ddcutil detect (as the console user, like owneetd)"
  runuser -u owneet -- env HOME=/home/owneet ddcutil detect --verbose 2>&1 | head -80; } >> "$base.report.txt"
# The windows of the console session, every 10 s (gamescope's X server): with the test tool
# owneet-xprobe, copied onto the stick by testers or installed by owneetd
windows() {
    local probe="$mnt/owneet-xprobe"
    [[ -x "$probe" ]] || probe=/usr/lib/owneet/owneet-xprobe
    [[ -x "$probe" ]] || return 0
    { echo "===== $(date '+%F %T')"
      runuser -u owneet -- env DISPLAY=:0 timeout 5 "$probe" 2>&1; } >> "$base.windows.txt"
}
# What the screen shows, every 30 seconds (owner, 2026-11-12: faults of the look seen as the tester saw
# them, open item 3w): gamescope's own screenshot, a game included, in $base.screens/HHMMSS.png; the last
# 240 are kept (two hours). None in the reduced session (no gamescope) or on the OwneetOS stick itself
# (too little room). Read back as the console user, never through a link as root.
last_shot=-30
screenshot() {
    (( SECONDS - last_shot >= 30 )) || return 0
    last_shot=$SECONDS
    local uid run tmp
    uid="$(id -u owneet 2>/dev/null)" || return 0
    run="/run/user/$uid"
    [[ -S "$run/gamescope-0" ]] || return 0
    tmp="$run/owneet-testlog-screen.png"
    runuser -u owneet -- rm -f "$tmp"
    runuser -u owneet -- env XDG_RUNTIME_DIR="$run" GAMESCOPE_WAYLAND_DISPLAY=gamescope-0 \
        timeout 10 gamescopectl screenshot "$tmp" >/dev/null 2>&1 || return 0
    # gamescope writes the file when its next frame is ready: at most 5 s
    for _ in $(seq 1 25); do [[ -s "$tmp" ]] && break; sleep 0.2; done
    [[ -s "$tmp" ]] || return 0
    mkdir -p "$base.screens"
    runuser -u owneet -- cat "$tmp" > "$base.screens/$(date +%H%M%S).png"
    runuser -u owneet -- rm -f "$tmp"
    find "$base.screens" -maxdepth 1 -name '*.png' -printf '%f\n' | sort | head -n -240 \
        | while IFS= read -r old; do rm -f "$base.screens/$old"; done
}
# Waking the console with the controller (step 6.10, a test; owner 2026-11-13): with the switch
# owneet.debug.bt_wake=on in owneet-debug.txt, every USB Bluetooth adapter, and the USB hubs and
# controller it hangs from, may wake the PC from sleep, and every paired device may wake it through
# BlueZ (WakeAllowed). Done once BlueZ is there; what each one says goes in $base.wake.txt. The
# kernel's sleep and wake are in the journal.
wake_done=0
bt_wake() {
    (( wake_done )) && return 0
    tr -d '\r' < "$mnt/owneet-debug.txt" 2>/dev/null | grep -qx 'owneet.debug.bt_wake=on' || { wake_done=1; return 0; }
    busctl status org.bluez >/dev/null 2>&1 || return 0
    wake_done=1
    local hci p obj
    {
        echo "===== $(date '+%F %T') waking with the controller (test switch owneet.debug.bt_wake=on)"
        for hci in /sys/class/bluetooth/hci*; do
            [[ -e "$hci/device" ]] || continue
            p="$(readlink -f "$hci/device")"
            echo "--- $(basename "$hci"): $p"
            while [[ "$p" == /sys/devices/* ]]; do
                if [[ -w "$p/power/wakeup" ]]; then
                    echo enabled > "$p/power/wakeup" 2>/dev/null
                    echo "$p: wakeup $(cat "$p/power/wakeup" 2>/dev/null)"
                fi
                p="$(dirname "$p")"
            done
        done
        echo "--- /proc/acpi/wakeup"
        cat /proc/acpi/wakeup 2>/dev/null
        echo "--- paired devices"
        busctl --list tree org.bluez 2>/dev/null | grep -E '^/org/bluez/hci[0-9]+/dev_[0-9A-F_]+$' | while IFS= read -r obj; do
            [[ "$(busctl get-property org.bluez "$obj" org.bluez.Device1 Paired 2>/dev/null)" == "b true" ]] || continue
            busctl set-property org.bluez "$obj" org.bluez.Device1 WakeAllowed b true 2>&1
            echo "$obj $(busctl get-property org.bluez "$obj" org.bluez.Device1 Name 2>/dev/null)" \
                "WakeAllowed: $(busctl get-property org.bluez "$obj" org.bluez.Device1 WakeAllowed 2>&1)"
        done
    } >> "$base.wake.txt" 2>&1
}
# On the OwneetOS stick itself: stop adding to a file once it reaches 1 MB
room() { (( ! small )) || (( $(stat -c %s "$1" 2>/dev/null || echo 0) < 1000000 )); }
while true; do
    (( small )) || bt_wake
    room "$base.report.txt" && report >> "$base.report.txt" 2>&1
    # no Steam or game logs on the OwneetOS stick itself: too little room
    (( small )) || steam_logs
    (( small )) || game_logs
    room "$base.windows.txt" && windows
    (( small )) || screenshot
    sync
    sleep 10 &
    wait $!
done
