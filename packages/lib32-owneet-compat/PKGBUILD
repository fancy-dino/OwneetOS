# Maintainer: OwneetOS project <https://github.com/fancy-dino/OwneetOS>
#
# OwneetOS's own 32-bit compatibility libraries for old Linux games, loaded only for the files the
# list of known games names (frontend/known-games, [[games-on-disk]], owner 2026-11-12):
# old-sdl2-launcher, what old launchers made for SDL2 expected from it (The Witcher 2's TV
# launcher); no-crash-reporter, a game's own crash reporter not started. Sources in compat/.

pkgname=lib32-owneet-compat
pkgver=0.4.0
pkgrel=1
pkgdesc="OwneetOS compatibility libraries for old 32-bit Linux games"
arch=('x86_64')
url="https://github.com/fancy-dino/OwneetOS"
license=('GPL-3.0-or-later')
depends=('lib32-glibc')
makedepends=('lib32-gcc-libs')
options=('!debug')
# lib32-owneet-compat-src.tar.gz is generated from compat/ by tools/build-packages (source-dirs).
source=('lib32-owneet-compat-src.tar.gz')
sha256sums=('SKIP')

_libs=(old-sdl2-launcher no-crash-reporter)

build() {
  cd compat
  for lib in "${_libs[@]}"; do
    gcc -m32 $CFLAGS -shared -fPIC -Wall -Wextra -Werror $LDFLAGS \
      -o "libowneet-$lib.so" "$lib/$lib.c" -ldl
  done
}

check() {
  cd compat
  for lib in "${_libs[@]}"; do
    "$lib/test/run.sh" "$srcdir/test-build/$lib"
  done
}

package() {
  cd compat
  for lib in "${_libs[@]}"; do
    install -Dm755 "libowneet-$lib.so" "$pkgdir/usr/lib32/owneet/libowneet-$lib.so"
  done
}
