// The logo ([[step-7.6-final-logo-and-brand]], approved demo design/demos/7.6-logo.html), drawn from
// the same outlines as the boot splash (LogoData, generated by tools/branding/make-logo), with no
// images: the symbol on the left of the word (the top bar: `size` is the symbol's diameter) or above
// it (full screen: `size` is the word's width). Colours: the palette's, or the given ones.
import QtQuick 2.15

Canvas {
    id: root
    property string layout: "left"
    property real size: Theme.px(30)
    property color letters: Theme.fg
    property color os: Theme.accent
    property color symbol: Theme.accent

    readonly property bool above: layout === "above"
    width: above ? size : size * (LogoData.leftSize + LogoData.leftGap + LogoData.wordWidth) / LogoData.leftSize
    height: above ? size * (LogoData.aboveSize + LogoData.aboveGap + LogoData.wordHeight) / LogoData.wordWidth : size

    onWidthChanged: requestPaint()
    onLettersChanged: requestPaint()
    onOsChanged: requestPaint()
    onSymbolChanged: requestPaint()

    onPaint: {
        const ctx = getContext("2d");
        ctx.reset();
        const units = above ? width / LogoData.wordWidth : height / LogoData.leftSize;
        ctx.scale(units, units);
        // the symbol, then the word: on the left, on the word's middle line; above, centred over it
        const diameter = above ? LogoData.aboveSize : LogoData.leftSize;
        const gap = above ? LogoData.aboveGap : LogoData.leftGap;
        ctx.save();
        if (above)
            ctx.translate((LogoData.wordWidth - diameter) / 2, 0);
        ctx.scale(diameter / 100, diameter / 100);
        ctx.fillRule = Qt.OddEvenFill;
        ctx.fillStyle = symbol;
        ctx.path = LogoData.shell;
        ctx.fill();
        ctx.fillRule = Qt.WindingFill;
        ctx.path = LogoData.buttons;
        ctx.fill();
        ctx.restore();
        if (above)
            ctx.translate(-LogoData.left, diameter + gap - LogoData.top);
        else
            ctx.translate(diameter + gap - LogoData.left, (diameter - LogoData.wordHeight) / 2 - LogoData.top);
        for (let i = 0; i < LogoData.letters.length; i++) {
            ctx.fillStyle = i < 6 ? letters : os;
            ctx.path = LogoData.letters[i];
            ctx.fill();
        }
    }
}
