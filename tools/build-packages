#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Builds the PKGBUILDs in packages/ in a clean chroot and creates the [owneet] repository
# in out/repo/x86_64/. Runs inside the builder VM:
#   tools/build-in-vm tools/build-packages            build every package
#   tools/build-in-vm tools/build-packages NAME...    build only these packages
#
# The chroot uses the same Arch Linux Archive snapshot as the ISO (iso/pacman.conf), so packages
# are built against exactly the libraries they will run with.

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CHROOT_DIR="/var/tmp/owneet-chroot"
REPO_NAME="owneet"
REPO_DIR="$ROOT/out/repo/x86_64"

die() { echo "error: $*" >&2; exit 1; }
info() { echo "==> $*"; }

command -v makechrootpkg >/dev/null 2>&1 \
    || die "devtools not found. Build inside the builder VM: tools/build-in-vm tools/build-packages"

cd "$ROOT"

if [[ $# -gt 0 ]]; then
    pkgs=("$@")
else
    mapfile -t pkgs < <(find packages -mindepth 2 -maxdepth 2 -name PKGBUILD -printf '%h\n' | xargs -rn1 basename | sort)
fi
[[ ${#pkgs[@]} -gt 0 ]] || die "no PKGBUILDs found in packages/"

# pacman configuration for the chroot: the ISO's snapshot repositories, without ISO-only options.
chroot_conf="$(mktemp)"
trap 'rm -f "$chroot_conf"' EXIT
grep -v '^NoExtract' iso/pacman.conf > "$chroot_conf"
snapshot="$(grep -m1 -oE 'repos/[0-9]{4}/[0-9]{2}/[0-9]{2}' "$chroot_conf" | cut -d/ -f2-)"

# Recreate the chroot when the snapshot date changes; otherwise reuse it (faster).
if [[ -d "$CHROOT_DIR/root" && "$(cat "$CHROOT_DIR/snapshot" 2>/dev/null)" != "$snapshot" ]]; then
    info "snapshot changed to $snapshot: recreating the build chroot"
    sudo rm -rf "$CHROOT_DIR"
fi
if [[ ! -d "$CHROOT_DIR/root" ]]; then
    info "creating the build chroot (Arch snapshot $snapshot)"
    sudo mkdir -p "$CHROOT_DIR"
    sudo mkarchroot -C "$chroot_conf" "$CHROOT_DIR/root" base-devel >/dev/null
    echo "$snapshot" | sudo tee "$CHROOT_DIR/snapshot" >/dev/null
fi

# Dependencies between OwneetOS packages (depends + makedepends that are also in packages/).
all_pkgs="$(find packages -mindepth 2 -maxdepth 2 -name PKGBUILD -printf '%h\n' | xargs -rn1 basename)"
local_deps() {
    # shellcheck disable=SC1090,SC2154  # PKGBUILDs define depends/makedepends
    ( source "packages/$1/PKGBUILD" >/dev/null 2>&1; printf '%s\n' "${depends[@]}" "${makedepends[@]}" ) \
        | sed 's/[<>=].*//' | grep -Fxf <(echo "$all_pkgs") || true
}

# Build order: a package comes after the OwneetOS packages it depends on.
ordered=()
remaining=("${pkgs[@]}")
while (( ${#remaining[@]} )); do
    progress=0 next=()
    for pkg in "${remaining[@]}"; do
        [[ -f "packages/$pkg/PKGBUILD" ]] || die "packages/$pkg/PKGBUILD not found"
        ready=1
        for dep in $(local_deps "$pkg"); do
            if printf '%s\n' "${remaining[@]}" | grep -qFx "$dep" && [[ "$dep" != "$pkg" ]]; then ready=0; fi
        done
        if (( ready )); then ordered+=("$pkg"); progress=1; else next+=("$pkg"); fi
    done
    (( progress )) || die "circular dependency between: ${next[*]}"
    remaining=("${next[@]}")
done

mkdir -p "$REPO_DIR"
# Drop the database first: if a build fails, no stale (possibly signed) database is left behind.
rm -f "$REPO_DIR/$REPO_NAME".{db,files}*
for pkg in "${ordered[@]}"; do
    info "building $pkg"
    rm -f "$REPO_DIR/$pkg"-[0-9]*.pkg.tar.zst "$REPO_DIR/$pkg"-[0-9]*.pkg.tar.zst.sig
    # Packages without a build() step (scripts and data only) need none of their dependencies in
    # the chroot: skip them instead of downloading (and running install scripts of) hundreds of MB.
    makepkg_args=(--noconfirm)
    install_args=()
    if ! grep -qE '^build\(\)' "packages/$pkg/PKGBUILD"; then
        makepkg_args+=(--nodeps)
    else
        # OwneetOS dependencies are not in the Arch repositories: install the freshly built ones.
        for dep in $(local_deps "$pkg"); do
            for f in "$REPO_DIR/$dep"-[0-9]*.pkg.tar.zst; do
                if [[ -f "$f" ]]; then install_args+=(-I "$f"); fi
            done
        done
    fi
    (
        cd "packages/$pkg"
        PKGDEST="$REPO_DIR" makechrootpkg -c -r "$CHROOT_DIR" "${install_args[@]}" -- "${makepkg_args[@]}" >/dev/null
    ) || die "build of $pkg failed"
done

info "updating the [$REPO_NAME] repository database"
rm -f "$REPO_DIR/$REPO_NAME".{db,files}*
repo-add --quiet "$REPO_DIR/$REPO_NAME.db.tar.gz" "$REPO_DIR"/*.pkg.tar.zst
info "the repository is UNSIGNED (development). Key holders sign it with: tools/sign-repo"

info "repository ready in out/repo/x86_64:"
find "$REPO_DIR" -maxdepth 1 -name '*.pkg.tar.zst' -printf '    %f\n' | sort
