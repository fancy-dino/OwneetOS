#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Shows the interface without booting an ISO: runs the owneet-frontend package from out/repo on
# a virtual screen (Xvfb) in a throwaway container inside the builder VM, with test games and a
# virtual Xbox-style controller, follows a list of steps and saves screenshots in
# out/frontend-preview/.
#
#   tools/build-in-vm tools/build-packages owneet-frontend      (build the package first)
#   tools/build-in-vm tools/frontend-preview STEPS_FILE [WIDTHxHEIGHT]   (default 1280x720)
#
# STEPS_FILE, one step per line (the frontend starts with no saved settings):
#   key KEY...       keyboard keys, xdotool names (Down, Return, Escape, y, Next = Page Down…)
#   type TEXT        type text with the keyboard (e.g. a Wi-Fi password)
#   pad BUTTON...    controller buttons: a b x y lb rb lt rt menu view up down left right
#   stick STICK MS   hold a stick for MS ms: ls-up ls-down ls-left ls-right rs-up rs-down
#   hold BUTTON MS   hold a button or trigger for MS ms (e.g. hold rt 1600)
#   press BUTTON     press a button or trigger and keep it down (release BUTTON lets it go), e.g.
#                    to take a screenshot while it is held
#   shot NAME        screenshot: out/frontend-preview/NAME.png
#   wait SECONDS     pause
#   restart          restart the frontend (its settings are kept)
#   @nogames         (first line) start with no games, as on a new system
#   @owneetd         (first line) with a pretend owneetd: invented networks, controllers and
#                    Bluetooth devices (tools/preview-steps/fake-owneetd.py)
#   @steam           (with @owneetd) an invented Steam folder with owned games, installed or not
#                    (tools/preview-steps/fake-steam.py); the pretend owneetd installs and
#                    uninstalls them, with downloads
#   @disk            an invented USB disk "SSD-256GB-D" with a Giochi folder (games on a disk, 4.3;
#                    installers, 4.6):
#                    scripts, programs, covers (Starfall, Beneath a steel sky), Windows games, and
#                    folders with only an installer (GOG .sh, Inno Setup, too big, Galaxy, unknown)
#   @gamescope       (with @owneetd) the pretend session is gamescope's (Resume, the pointer)
#   @firststart      the first start (6.1) is shown, as on a new console (otherwise it counts as done)
#   unplug / plug    (with @disk) the invented disk is unplugged / plugged in again
#   event TYPE JSON  (with @owneetd) the pretend owneetd sends an event, e.g.
#                    event controller.battery {"id":"aa:bb:cc:dd:ee:01","name":"Xbox","battery":12}
#   # …              comment
# The frontend's log is out/frontend-preview/log.txt.

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CHROOT="/var/tmp/owneet-chroot/root"
BOX="/var/tmp/owneet-preview"
OUT="$ROOT/out/frontend-preview"

die() { echo "error: $*" >&2; exit 1; }

[[ $# -ge 1 && $# -le 2 ]] || { sed -n '4,36p' "$0" | sed 's/^# \{0,1\}//'; exit 1; }
STEPS="$(realpath "$1")"
SIZE="${2:-1280x720}"
[[ -f "$STEPS" ]] || die "$1 not found"
[[ "$SIZE" =~ ^[0-9]+x[0-9]+$ ]] || die "size must be WIDTHxHEIGHT"
{ command -v systemd-nspawn >/dev/null && [[ -d "$CHROOT" ]]; } \
    || die "run it in the builder VM after a package build: tools/build-in-vm tools/frontend-preview …"
mapfile -t pkgs < <(ls "$ROOT"/out/repo/x86_64/owneet-frontend-*.pkg.tar.zst "$ROOT"/out/repo/x86_64/owneet-branding-*.pkg.tar.zst 2>/dev/null)
[[ ${#pkgs[@]} -eq 2 ]] || die "build first: tools/build-in-vm tools/build-packages owneet-frontend"

if [[ ! -d "$BOX" ]]; then
    echo "==> creating the preview container (once)"
    sudo cp -a "$CHROOT" "$BOX"
    sudo systemd-nspawn -q -D "$BOX" pacman -Sy --noconfirm --needed \
        xorg-server-xvfb imagemagick xdotool python-evdev >/dev/null
fi
sudo cp "${pkgs[@]}" "$BOX/var/tmp/"
sudo systemd-nspawn -q -D "$BOX" sh -c \
    'pacman -U --noconfirm /var/tmp/owneet-*.pkg.tar.zst >/dev/null 2>&1; rm -f /var/tmp/owneet-*.pkg.tar.zst'
sudo cp "$STEPS" "$BOX/steps.txt"
sudo cp "$ROOT/CREDITS.md" "$BOX/CREDITS.md"   # installed by owneet-base on the console
sudo cp "$ROOT/tools/preview-steps/fake-owneetd.py" "$BOX/fake-owneetd.py"
sudo cp "$ROOT/tools/preview-steps/fake-steam.py" "$BOX/fake-steam.py"

# Virtual controller: an "Xbox 360 pad" (SDL maps it with SDL_GameControllerDB), driven
# through a FIFO.
sudo tee "$BOX/vpad.py" >/dev/null <<'EOF'
import sys, time
from evdev import UInput, AbsInfo, ecodes as e

STICK = AbsInfo(0, -32768, 32767, 16, 128, 0)
TRIGGER = AbsInfo(0, 0, 255, 0, 0, 0)
HAT = AbsInfo(0, -1, 1, 0, 0, 0)
ui = UInput({
    e.EV_KEY: [e.BTN_SOUTH, e.BTN_EAST, e.BTN_NORTH, e.BTN_WEST, e.BTN_TL, e.BTN_TR,
               e.BTN_SELECT, e.BTN_START, e.BTN_MODE, e.BTN_THUMBL, e.BTN_THUMBR],
    e.EV_ABS: [(e.ABS_X, STICK), (e.ABS_Y, STICK), (e.ABS_Z, TRIGGER), (e.ABS_RX, STICK),
               (e.ABS_RY, STICK), (e.ABS_RZ, TRIGGER), (e.ABS_HAT0X, HAT), (e.ABS_HAT0Y, HAT)],
}, name="Microsoft X-Box 360 pad", vendor=0x045e, product=0x028e, version=0x110, bustype=e.BUS_USB)

BUTTONS = {"a": e.BTN_SOUTH, "b": e.BTN_EAST, "x": e.BTN_NORTH, "y": e.BTN_WEST,
           "lb": e.BTN_TL, "rb": e.BTN_TR, "view": e.BTN_SELECT, "menu": e.BTN_START}
AXES = {"lt": (e.ABS_Z, 255), "rt": (e.ABS_RZ, 255), "up": (e.ABS_HAT0Y, -1), "down": (e.ABS_HAT0Y, 1),
        "left": (e.ABS_HAT0X, -1), "right": (e.ABS_HAT0X, 1)}
STICKS = {"ls-up": (e.ABS_Y, -32767), "ls-down": (e.ABS_Y, 32767), "ls-left": (e.ABS_X, -32767),
          "ls-right": (e.ABS_X, 32767), "rs-up": (e.ABS_RY, -32767), "rs-down": (e.ABS_RY, 32767)}


def emit(kind, code, value, hold):
    ui.write(kind, code, value); ui.syn(); time.sleep(hold)
    ui.write(kind, code, 0); ui.syn(); time.sleep(0.12)


def pull_trigger(code):
    """Like a real analog trigger: a stream of values in and out, with a tremble half-way."""
    for v in (20, 60, 100, 130, 125, 135, 128, 180, 230, 255, 250, 255, 200, 140, 120, 135, 90, 40, 0):
        ui.write(e.EV_ABS, code, v); ui.syn(); time.sleep(0.015)
    time.sleep(0.12)


print("ready", flush=True)
for line in open(sys.argv[1]):
    words = line.split()
    if words[0] == "pad":
        for b in words[1:]:
            if b in BUTTONS:
                emit(e.EV_KEY, BUTTONS[b], 1, 0.08)
            elif b in ("lt", "rt"):
                pull_trigger(AXES[b][0])
            else:
                emit(e.EV_ABS, AXES[b][0], AXES[b][1], 0.08)
    elif words[0] == "hold":
        b, ms = words[1], int(words[2]) / 1000
        if b in BUTTONS:
            emit(e.EV_KEY, BUTTONS[b], 1, ms)
        else:
            emit(e.EV_ABS, AXES[b][0], AXES[b][1], ms)
    elif words[0] in ("press", "release"):
        b = words[1]
        if b in BUTTONS:
            ui.write(e.EV_KEY, BUTTONS[b], 1 if words[0] == "press" else 0)
        else:
            ui.write(e.EV_ABS, AXES[b][0], AXES[b][1] if words[0] == "press" else 0)
        ui.syn(); time.sleep(0.12)
    elif words[0] == "stick":
        emit(e.EV_ABS, STICKS[words[1]][0], STICKS[words[1]][1], int(words[2]) / 1000)
    print("done", flush=True)
EOF

sudo tee "$BOX/run-preview.sh" >/dev/null <<'EOF'
#!/bin/sh
export OWNEET_CREDITS=/CREDITS.md OWNEETD_SOCKET=/tmp/owneetd.sock HOME=/tmp/home QT_QPA_PLATFORM=xcb LIBGL_ALWAYS_SOFTWARE=1 SDL_JOYSTICK_DISABLE_UDEV=1
rm -rf "$HOME"; mkdir -p "$HOME/.config/owneet-frontend" "$HOME/games"
printf 'collection: Test games\nshortname: test\n\n' > "$HOME/games/metadata.pegasus.txt"
if ! grep -q '^@nogames' /steps.txt; then
    for g in "Nebula Drift" "Moss Garden" "Ember Run" "Tiny Tactics" "Harbor Lights" "Pixel Quest" \
             "Starfall" "Velvet Road" "Copper Coast" "Lantern Keep" "Quiet Orbit" "Saltwind"; do
        f="$HOME/games/$(echo "$g" | tr ' ' _).sh"; touch "$f"
        printf 'game: %s\nfile: %s\nlaunch: /bin/true\n\n' "$g" "$f" >> "$HOME/games/metadata.pegasus.txt"
    done
fi
echo "$HOME/games" > "$HOME/.config/owneet-frontend/game_dirs.txt"
# The first start (6.1) only with @firststart; otherwise it counts as done
if ! grep -q '^@firststart' /steps.txt; then
    mkdir -p "$HOME/.config/owneet-frontend/theme_settings"
    echo '{"firstStartDone":true}' > "$HOME/.config/owneet-frontend/theme_settings/owneet.json"
fi
if grep -q '^@steam' /steps.txt; then
    python3 /fake-steam.py "$HOME/Steam"
    export OWNEET_STEAM_DIR="$HOME/Steam" FAKE_STEAM=1
fi

if grep -q '^@disk' /steps.txt; then
    disk=/tmp/disks/SSD-256GB-D; g="$disk/Giochi"
    rm -rf /tmp/disks /tmp/unplugged; mkdir -p /tmp/unplugged
    prog() { mkdir -p "$(dirname "$1")"; cp /usr/bin/true "$1"; chmod +x "$1"; }
    script() { mkdir -p "$(dirname "$1")"; printf '#!/bin/bash\nexec true\n' > "$1"; chmod +x "$1"; }
    script "$g/Beneath a steel sky/start.sh"; script "$g/Beneath a steel sky/support/xdg-open.sh"
    mkdir -p "$g/Beneath a steel sky/docs"
    script "$g/Cayne/start.sh"; prog "$g/Cayne/game/Cayne.x86_64"; prog "$g/Cayne/game/Cayne_Data/Plugins/helper"
    prog "$g/Lantern Keep/bin/lantern.x86_64"; script "$g/Lantern Keep/launcher.sh"
    prog "$g/Lantern Keep/tools/editor.x86_64"; script "$g/Lantern Keep/uninstall.sh"
    prog "$g/Starfall/Starfall.AppImage"
    magick -size 600x900 gradient:'#1d3557-#e76f51' "$g/Starfall/cover.jpg" 2>/dev/null \
        || convert -size 600x900 gradient:'#1d3557-#e76f51' "$g/Starfall/cover.jpg"
    magick -size 600x900 gradient:'#2b2d42-#8d99ae' "$g/Beneath a steel sky/cover.png" 2>/dev/null \
        || convert -size 600x900 gradient:'#2b2d42-#8d99ae' "$g/Beneath a steel sky/cover.png"
    mkdir -p "$g/Windows only"; : > "$g/Windows only/game.exe"
    # Windows games (4.5): one with GOG's info file (the file to start, in another case), one without
    mkdir -p "$g/Tyrian 2000/DOSBOX"; : > "$g/Tyrian 2000/DOSBOX/DOSBox.exe"; : > "$g/Tyrian 2000/DOSBOX/GOGDOSConfig.exe"
    : > "$g/Tyrian 2000/SETUP.EXE"
    printf '{"playTasks": [{"category": "game", "isPrimary": true, "type": "FileTask", "path": "DOSBOX\\\\dosbox.exe", "arguments": "-conf \\"..\\\\dosboxT2K.conf\\" -noconsole", "workingDir": "DOSBOX"}]}\n' \
        > "$g/Tyrian 2000/goggame-1.info"
    mkdir -p "$g/Ashen Gate/bin/x64" "$g/Ashen Gate/__redist"; : > "$g/Ashen Gate/AshenGate.exe"; : > "$g/Ashen Gate/bin/x64/AshenGate.exe"
    : > "$g/Ashen Gate/unins000.exe"; : > "$g/Ashen Gate/__redist/vcredist_x64.exe"
    # Installers (4.6): GOG's Linux installer (a script, then a ZIP archive with data/noarch and a
    # licence), GOG's Windows installer (Inno Setup, with a part), one too big for the console's
    # disk (a sparse file), GOG Galaxy's online installer, and an unknown kind
    mkdir -p "$g/Stargunner" "$g/Shadow Harbor" "$g/Titan Fields" "$g/Treasure Adventure Game" "$g/Old Relic"
    python3 - "$g/Stargunner/gog_stargunner_2.0.0.10.sh" <<'PY'
import io, sys, zipfile
buf = io.BytesIO()
with zipfile.ZipFile(buf, "w") as z:
    z.writestr("scripts/config.lua", "-- MojoSetup")
    z.writestr("data/noarch/start.sh", "#!/bin/sh\nexec true\n")
    z.writestr("data/noarch/game/data.bin", "x" * 4000000)
    z.writestr("data/noarch/docs/End User License Agreement.txt",
               "END USER LICENCE AGREEMENT (invented for the preview)\n\n" + "\n\n".join(
                   f"{n}. A clause of the licence, long enough to need scrolling with the right stick on the console's screen." for n in range(1, 25)))
open(sys.argv[1], "wb").write(b"#!/bin/sh\n# This script was generated using Makeself 2.4.0\n" + b"#" * 4000 + b"\nexit 0\n" + buf.getvalue())
PY
    printf 'MZ... Inno Setup Setup Data (6.2.0)' > "$g/Shadow Harbor/setup_shadow_harbor_1.4.2.exe"
    head -c 3000000 /dev/zero >> "$g/Shadow Harbor/setup_shadow_harbor_1.4.2.exe"
    : > "$g/Shadow Harbor/setup_shadow_harbor_1.4.2-1.bin"
    printf 'MZ... Inno Setup Setup Data (6.2.0)' > "$g/Titan Fields/setup_titan_fields_2.0.exe"
    truncate -s 300G "$g/Titan Fields/setup_titan_fields_2.0.exe"
    : > "$g/Treasure Adventure Game/GOG_Galaxy_Treasure_Adventure_Game.exe"
    printf 'MZ... a packer nobody knows' > "$g/Old Relic/OldRelic_setup.exe"
    # a game the console installed earlier (it can be uninstalled; its installer is on the disk)
    script "$HOME/Games/Old Lighthouse/start.sh"; head -c 50000000 /dev/zero > "$HOME/Games/Old Lighthouse/data.bin"
    printf '{"installer": "%s/Old Lighthouse/gog_old_lighthouse.sh", "kind": "sh"}' "$g" > "$HOME/Games/Old Lighthouse/.owneet-installed"
    ls -l "$g/Starfall" >> /out/log.txt
    export OWNEET_DISKS="$disk"
fi

if grep -q '^@owneetd' /steps.txt; then
    grep -q '^@gamescope' /steps.txt && export FAKE_SESSION=gamescope
    mkfifo /tmp/owneetd-events
    if grep -q '^@firststart' /steps.txt; then export FAKE_FIRSTSTART=1; fi
    python3 /fake-owneetd.py "$OWNEETD_SOCKET" /tmp/owneetd-events >> /out/log.txt 2>&1 &
    sleep 0.5
fi

mkfifo /tmp/vpad.in
python3 /vpad.py /tmp/vpad.in > /tmp/vpad.out 2>&1 &
exec 3>/tmp/vpad.in
sleep 1
start() { owneet-frontend >> /out/log.txt 2>&1 & FE=$!; sleep 7; }
start
while IFS= read -r line; do
    set -- $line
    case "${1:-#}" in
        \#*|@*) ;;
        key) shift; for k in "$@"; do xdotool key "$k"; sleep 0.3; done ;;
        type) shift; xdotool type --delay 60 "$*"; sleep 0.3 ;;
        event) shift; echo "$*" > /tmp/owneetd-events; sleep 0.5 ;;
        pad|stick|hold|press|release) n=$(grep -c done /tmp/vpad.out); echo "$line" >&3
                   while [ "$(grep -c done /tmp/vpad.out)" -le "$n" ]; do sleep 0.1; done; sleep 0.3 ;;
        shot) sleep 1; import -window root "/out/$2.png"; echo "$2.png" ;;
        wait) sleep "$2" ;;
        restart) kill "$FE"; wait "$FE" 2>/dev/null; start ;;
        unplug) mv /tmp/disks/SSD-256GB-D /tmp/unplugged/; sleep 1 ;;
        plug) mv /tmp/unplugged/SSD-256GB-D /tmp/disks/; sleep 1 ;;
        *) echo "unknown step: $line" ;;
    esac
done < /steps.txt
kill "$FE" 2>/dev/null
grep -i "gamepad\|controller" /out/log.txt | head -3
EOF
sudo chmod +x "$BOX/run-preview.sh"

rm -rf "$OUT"; mkdir -p "$OUT"
sudo modprobe uinput
sudo systemd-nspawn -q -D "$BOX" --bind="$OUT:/out" --bind=/dev/uinput --bind=/dev/input \
    --property=DeviceAllow='/dev/uinput rw' --property=DeviceAllow='char-input rw' \
    xvfb-run -a -s "-screen 0 ${SIZE}x24" /run-preview.sh
echo "==> screenshots in out/frontend-preview/"
