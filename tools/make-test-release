#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
#
# A pretend OwneetOS release for testing updates in the test VM ([[step-7.1-updates]],
# [[step-7.1b-going-back-to-any-version]]), laid out as the GitHub Releases the console reads:
# out/test-release/updates/releases.json(.sig), listing every test release made so far (newest
# first), and out/test-release/vVERSION/ (every OwneetOS package of out/repo, as a real release
# publishes them, owneet-updates at VERSION, the repository database, signatures). With
# --extra NAME, owneet-updates of that release depends on a small empty package NAME, so updating to
# it installs one package more and going back from it has one to remove.
# Everything is signed with a THROWAWAY test key made here, never with the project's keys; its
# GnuPG home stays in the builder VM (~/.owneet-test-gnupg, never copied out with out/), and only
# its public half is out/test-release/test-key.asc, which only the test VM trusts. Runs inside the
# builder VM:
#   tools/build-in-vm tools/make-test-release [--extra NAME] VERSION [ARCHIVE-DATE]
# then serve out/test-release over HTTP and point the test VM's /etc/owneet/updates.conf to it.

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
EXTRA=""
if [[ "${1:-}" == --extra ]]; then EXTRA="${2:?--extra NAME}"; shift 2; fi
VERSION="${1:?usage: tools/make-test-release [--extra NAME] VERSION [ARCHIVE-DATE YYYY/MM/DD]}"
ARCHIVE="${2:-$(grep -m1 -oE 'repos/[0-9]{4}/[0-9]{2}/[0-9]{2}' "$ROOT/iso/pacman.conf" | cut -d/ -f2-)}"
OUT="$ROOT/out/test-release"
rm -rf "$OUT/v$VERSION"
mkdir -p "$OUT/updates" "$OUT/v$VERSION"

# The throwaway test key: made in the builder VM, never the project's, never copied out; made again
# once it has expired (it lasts a day: trust test-key.asc again in the test VM)
export GNUPGHOME="$HOME/.owneet-test-gnupg"
if [[ ! -d "$GNUPGHOME" ]] || ! gpg --batch --with-colons --list-secret-keys 2>/dev/null | grep -q '^sec:[-qmfu]:'; then
    rm -rf "$GNUPGHOME"
    mkdir -m 700 "$GNUPGHOME"
    gpg --batch --quiet --pinentry-mode loopback --passphrase '' \
        --quick-gen-key "OwneetOS TEST KEY (never for releases) <test@invalid>" ed25519 sign 1d
fi
gpg --armor --export > "$OUT/test-key.asc"
sign() { gpg --batch --yes --quiet --detach-sign --no-armor -o "$1.sig" "$1"; }

# Every other OwneetOS package, as built in out/repo
for p in "$ROOT/out/repo/x86_64"/*.pkg.tar.zst; do
    [[ "$(basename "$p")" == owneet-updates-* ]] || cp "$p" "$OUT/v$VERSION/"
done
# owneet-updates at VERSION (the package that carries OwneetOS's version)
work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT
mkdir -p "$work/updates"
cp -a "$ROOT/packages/owneet-updates/." "$work/updates/"
sed -i "s/^pkgver=.*/pkgver=$VERSION/" "$work/updates/PKGBUILD"
if [[ -n "$EXTRA" ]]; then
    mkdir -p "$work/extra"
    printf '%s\n' "pkgname=$EXTRA" "pkgver=1" "pkgrel=1" \
        "pkgdesc=\"A test package that only test release $VERSION has\"" "arch=('any')" \
        "license=('GPL-3.0-or-later')" "package() { install -dm755 \"\$pkgdir/usr/share/$EXTRA\"; }" \
        > "$work/extra/PKGBUILD"
    (cd "$work/extra" && PKGDEST="$OUT/v$VERSION" makepkg --clean --force >/dev/null)
    sed -i "s/^depends=(/depends=('$EXTRA' /" "$work/updates/PKGBUILD"
fi
(cd "$work/updates" && PKGDEST="$OUT/v$VERSION" makepkg --nodeps --clean --force >/dev/null)
for p in "$OUT/v$VERSION"/*.pkg.tar.zst; do sign "$p"; done
rm -f "$OUT/v$VERSION"/owneet.db* "$OUT/v$VERSION"/owneet.files*
repo-add --quiet "$OUT/v$VERSION/owneet.db.tar.gz" "$OUT/v$VERSION"/*.pkg.tar.zst
# GitHub Releases have no symbolic links: the database under its plain name, signed
for f in owneet.db owneet.files; do
    rm -f "$OUT/v$VERSION/$f"; cp "$OUT/v$VERSION/$f.tar.gz" "$OUT/v$VERSION/$f"; sign "$OUT/v$VERSION/$f"
done

# The list of releases, newest first, one per line: this one and the test releases made before
line="{\"version\": \"$VERSION\", \"date\": \"$(date -u +%F)\", \"archive\": \"$ARCHIVE\", \"notes\": {\"en\": \"Test release $VERSION.\", \"it\": \"Release di prova $VERSION.\"}}"
old=()
if [[ -f "$OUT/updates/releases.json" ]]; then
    mapfile -t old < <(grep -E '^\{"version":' "$OUT/updates/releases.json" | sed -E 's/,[[:space:]]*$//' \
        | grep -vF "\"version\": \"$VERSION\"" || true)
fi
{
    echo '{"releases": ['
    printf '%s\n' "$line" "${old[@]}" | sort -t'"' -k4,4 -V -r | sed '$!s/$/,/'
    echo ']}'
} > "$OUT/updates/releases.json"
sign "$OUT/updates/releases.json"
echo "==> test release $VERSION in out/test-release (signed with the throwaway test key)"
