#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
#
# A pretend OwneetOS release for testing updates in the test VM ([[step-7.1-updates]]), laid out as
# the GitHub Releases the console reads: out/test-release/updates/releases.json(.sig) and
# out/test-release/vVERSION/ (owneet-updates at VERSION, the repository database, signatures).
# Everything is signed with a THROWAWAY test key made here, never with the project's keys; its
# GnuPG home stays in the builder VM (~/.owneet-test-gnupg, never copied out with out/), and only
# its public half is out/test-release/test-key.asc, which only the test VM trusts. Runs inside the
# builder VM:
#   tools/build-in-vm tools/make-test-release VERSION [ARCHIVE-DATE]
# then serve out/test-release over HTTP and point the test VM's /etc/owneet/updates.conf to it.

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
VERSION="${1:?usage: tools/make-test-release VERSION [ARCHIVE-DATE YYYY/MM/DD]}"
ARCHIVE="${2:-$(grep -m1 -oE 'repos/[0-9]{4}/[0-9]{2}/[0-9]{2}' "$ROOT/iso/pacman.conf" | cut -d/ -f2-)}"
OUT="$ROOT/out/test-release"
mkdir -p "$OUT/updates" "$OUT/v$VERSION"

# The throwaway test key: made once in the builder VM, never the project's, never copied out
export GNUPGHOME="$HOME/.owneet-test-gnupg"
if [[ ! -d "$GNUPGHOME" ]]; then
    mkdir -m 700 "$GNUPGHOME"
    gpg --batch --quiet --pinentry-mode loopback --passphrase '' \
        --quick-gen-key "OwneetOS TEST KEY (never for releases) <test@invalid>" ed25519 sign 1d
fi
gpg --armor --export > "$OUT/test-key.asc"
sign() { gpg --batch --yes --quiet --detach-sign --no-armor -o "$1.sig" "$1"; }

# owneet-updates at VERSION (the package that carries OwneetOS's version)
work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT
cp -a "$ROOT/packages/owneet-updates/." "$work/"
sed -i "s/^pkgver=.*/pkgver=$VERSION/" "$work/PKGBUILD"
(cd "$work" && PKGDEST="$OUT/v$VERSION" makepkg --nodeps --clean --force >/dev/null)
for p in "$OUT/v$VERSION"/*.pkg.tar.zst; do sign "$p"; done
rm -f "$OUT/v$VERSION"/owneet.db* "$OUT/v$VERSION"/owneet.files*
repo-add --quiet "$OUT/v$VERSION/owneet.db.tar.gz" "$OUT/v$VERSION"/*.pkg.tar.zst
# GitHub Releases have no symbolic links: the database under its plain name, signed
for f in owneet.db owneet.files; do
    rm -f "$OUT/v$VERSION/$f"; cp "$OUT/v$VERSION/$f.tar.gz" "$OUT/v$VERSION/$f"; sign "$OUT/v$VERSION/$f"
done

# The list of releases, newest first, one per line
cat > "$OUT/updates/releases.json" <<EOF
{"releases": [
{"version": "$VERSION", "date": "$(date -u +%F)", "archive": "$ARCHIVE", "notes": {"en": "A test release.", "it": "Una release di prova."}}
]}
EOF
sign "$OUT/updates/releases.json"
echo "==> test release $VERSION in out/test-release (signed with the throwaway test key)"
