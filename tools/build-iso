#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Builds the OwneetOS ISO from the archiso profile in iso/ into out/.
# Runs inside the builder VM (it needs root and archiso):
#   tools/build-in-vm tools/build-iso

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
WORK_DIR="/var/tmp/owneet-iso-work"
# Largest file on a FAT32 USB stick (some ISO writers copy the file): the ISO is published on
# SourceForge, not on GitHub Releases ([[distribution-and-updates]])
MAX_ISO_BYTES=$(( 4 * 1024 * 1024 * 1024 - 1 ))

die() { echo "error: $*" >&2; exit 1; }

command -v mkarchiso >/dev/null 2>&1 \
    || die "mkarchiso not found. Build inside the builder VM: tools/build-in-vm tools/build-iso"

cd "$ROOT"

# Reproducible dates: the ISO version is the date of the last commit, not the build time.
if git rev-parse --git-dir >/dev/null 2>&1; then
    SOURCE_DATE_EPOCH="$(git log -1 --format=%ct)"
    export SOURCE_DATE_EPOCH
fi

mkdir -p out
rm -f out/owneetos-*.iso out/owneetos-*.iso.sha256
sudo rm -rf "$WORK_DIR"

# OwneetOS packages come from the local [owneet] repository built by tools/build-packages.
repo_dir="$ROOT/out/repo/x86_64"
if [[ ! -f "$repo_dir/owneet.db" ]]; then
    echo "==> no [owneet] repository yet: building the packages first"
    "$ROOT/tools/build-packages"
fi

# Build from a copy of the profile whose pacman.conf also lists the local [owneet] repository
# (first, so OwneetOS packages take precedence). iso/ itself stays independent of the VM layout.
profile="$(mktemp -d)"
trap 'rm -rf "$profile"' EXIT
cp -a "$ROOT/iso/." "$profile/"
# Systems installed from the stick (owneet-tester-install) use the same Arch Linux Archive snapshot
mkdir -p "$profile/airootfs/usr/share/owneet"
cp "$ROOT/iso/pacman.conf" "$profile/airootfs/usr/share/owneet/pacman.conf"
# Never reuse OwneetOS packages from pacman's cache: a cached copy with the same version (and its
# old signature) would silently replace the package that was just built.
sudo find /var/cache/pacman/pkg -maxdepth 1 -name 'owneet-*' -delete

# A repository signed with tools/sign-repo is verified against the OwneetOS key; an unsigned one is
# accepted only as a development build (release builds must be signed,
# [[step-7.2-release-pipeline]]).
keyring="$ROOT/packages/owneet-keyring"
if [[ -f "$repo_dir/owneet.db.sig" ]]; then
    siglevel="Required DatabaseRequired"
    key="$(cut -d: -f1 "$keyring/owneet-trusted")"
    echo "==> signed [owneet] repository: verifying against key $key"
    sudo pacman-key --add "$keyring/owneet.gpg" >/dev/null 2>&1
    sudo pacman-key --lsign-key "$key" >/dev/null 2>&1
else
    siglevel="Optional TrustAll"
    echo "==> WARNING: the [owneet] repository is NOT signed: this is a development build only"
fi
awk -v repo="$repo_dir" -v siglevel="$siglevel" '
    /^\[core\]/ && !done {
        print "[owneet]"
        print "SigLevel = " siglevel
        print "Server = file://" repo
        print ""
        done = 1
    }
    { print }
' "$ROOT/iso/pacman.conf" > "$profile/pacman.conf"

# Optional apps carried by the ISO but not installed ([[step-5.0.0-optional-web-apps]]): the
# packages below, with the dependencies the ISO lacks, go into a small offline repository
# /usr/share/owneet/bundled/ that owneet-apps installs from when the user picks a web app.
BUNDLED=(brave-bin)
bundle_dir="$profile/airootfs/usr/share/owneet/bundled"
echo "==> bundling ${BUNDLED[*]} with the dependencies the ISO lacks"
dbpath="$(mktemp -d /var/tmp/owneet-bundle-db.XXXXXX)"
sudo pacman --config "$profile/pacman.conf" --dbpath "$dbpath" -Sy >/dev/null
mapfile -t iso_pkgs < <(grep -vE '^\s*(#|$)' "$ROOT/iso/packages.x86_64")
# Everything a fresh system needs for the ISO alone, and for the ISO plus the bundle: the
# difference is the bundle
resolve() { sudo pacman --config "$profile/pacman.conf" --dbpath "$dbpath" -Sp --noconfirm --print-format '%n' "$@"; }
mapfile -t bundle < <(comm -13 <(resolve "${iso_pkgs[@]}" | sort -u) \
                               <(resolve "${iso_pkgs[@]}" "${BUNDLED[@]}" | sort -u))
(( ${#bundle[@]} )) || die "nothing to bundle: are ${BUNDLED[*]} in the ISO already?"
mkdir -p "$bundle_dir"
# pacman checks every package's signature (Arch) while downloading
sudo pacman --config "$profile/pacman.conf" --dbpath "$dbpath" --cachedir "$bundle_dir" \
    -Sw --noconfirm -dd "${bundle[@]}" >/dev/null
sudo rm -rf "$dbpath"
sudo repo-add --quiet "$bundle_dir/bundled.db.tar.gz" "$bundle_dir"/*.pkg.tar.zst
# mkarchiso makes the files root's in the image; here they stay removable with the profile copy
sudo chown -R "$(id -u):$(id -g)" "$bundle_dir"
echo "==> bundled $(printf '%s ' "${bundle[@]}")($(du -sm "$bundle_dir" | cut -f1) MiB)"

echo "==> building the ISO (work dir: $WORK_DIR)"
sudo mkarchiso -v -r -w "$WORK_DIR" -o "$ROOT/out" "$profile"

iso="$(find out -maxdepth 1 -name 'owneetos-*.iso' | head -1)"
[[ -n "$iso" ]] || die "mkarchiso finished but no ISO was found in out/"
sudo chown "$(id -u):$(id -g)" "$iso"

# Every file of the image must match its package (2026-10-13: erofs with LZMA had silently
# corrupted six files). The image is unpacked and checked against the packages' checksums;
# configuration in /etc and /var may differ on purpose.
echo "==> checking every file of the image against its package"
check="$(mktemp -d /var/tmp/owneet-iso-check.XXXXXX)"
bsdtar -xf "$iso" -C "$check" "owneet/x86_64/airootfs.sfs" || die "cannot read the system image"
sudo unsquashfs -q -n -d "$check/root" "$check/owneet/x86_64/airootfs.sfs" >/dev/null \
    || die "cannot unpack the system image"
bad="$(sudo pacman --root "$check/root" -Qkk 2>&1 | grep -E 'checksum mismatch|size mismatch' \
       | grep -vE ': /(etc|var)/' || true)"
sudo rm -rf "$check"
if [[ -n "$bad" ]]; then
    echo "$bad" >&2
    die "files of the image differ from their packages: the image is damaged"
fi
echo "==> every file matches its package"
(cd out && sha256sum "$(basename "$iso")" > "$(basename "$iso").sha256")

size="$(stat -c %s "$iso")"
echo "==> built $iso ($(( size / 1024 / 1024 )) MiB)"
if (( size > MAX_ISO_BYTES )); then
    die "the ISO is 4 GiB or larger: too big for a FAT32 USB stick ([[distribution-and-updates]])"
fi
