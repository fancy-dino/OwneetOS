#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Checks that the current commit is a complete release commit for VERSION, before anything is
# built ([[step-7.2-release-pipeline]]):
#
#   tools/release/check VERSION
#
#  - VERSION is MAJOR.MINOR.PATCH and newer than the previous release (the previous v* tag);
#  - owneet-updates carries it (pkgver: the version of OwneetOS, /usr/share/owneet/version);
#  - release-notes/VERSION/LANG.txt exists, not empty, for every language of the console;
#  - every OwneetOS package changed since the previous release has a new version, or installed
#    consoles would never receive the change.

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
# The languages of the console ([[languages]]): the notes are shown in the player's language
LANGUAGES=(en it de fr es)

VERSION="${1:-}"
errors=0
fail() { echo "error: $*" >&2; errors=$(( errors + 1 )); }
[[ "$VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || { echo "usage: tools/release/check MAJOR.MINOR.PATCH" >&2; exit 2; }
cd "$ROOT"

# pkgver=... (and pkgrel) of a PKGBUILD, from a file or from git ("REV:path")
field() { sed -nE "s/^$1=['\"]?([^'\" ]+)['\"]?.*/\1/p" | head -1; }

current="$(field pkgver < packages/owneet-updates/PKGBUILD)"
[[ "$current" == "$VERSION" ]] || fail "packages/owneet-updates/PKGBUILD has pkgver=$current, not $VERSION"

for lang in "${LANGUAGES[@]}"; do
    notes="release-notes/$VERSION/$lang.txt"
    if [[ ! -s "$notes" ]] || ! grep -q '[^[:space:]]' "$notes"; then fail "$notes is missing or empty"; fi
done

previous="$(git describe --tags --abbrev=0 --match 'v[0-9]*.[0-9]*.[0-9]*' HEAD^ 2>/dev/null || true)"
if [[ -z "$previous" ]]; then
    echo "==> first release: no previous release to compare with"
else
    echo "==> previous release: $previous"
    [[ "$(vercmp "$VERSION" "${previous#v}")" -gt 0 ]] || fail "$VERSION is not newer than $previous"
    for dir in packages/*/; do
        pkg="$(basename "$dir")"
        [[ -f "$dir/PKGBUILD" ]] || continue
        git cat-file -e "$previous:${dir}PKGBUILD" 2>/dev/null || continue   # new package
        # What goes into the package: its folder and, for packages built from this repository, the
        # folders listed in source-dirs
        paths=("$dir")
        [[ -f "$dir/source-dirs" ]] && mapfile -t -O 1 paths < <(grep -v '^\s*$' "$dir/source-dirs")
        git diff --quiet "$previous" HEAD -- "${paths[@]}" && continue
        before="$(git show "$previous:${dir}PKGBUILD" | field pkgver)-$(git show "$previous:${dir}PKGBUILD" | field pkgrel)"
        now="$(field pkgver < "$dir/PKGBUILD")-$(field pkgrel < "$dir/PKGBUILD")"
        [[ "$before" != "$now" ]] || fail "$pkg changed since $previous but its version is still $now"
    done
fi

(( errors == 0 )) || { echo "==> $errors problem(s): not a release commit for $VERSION" >&2; exit 1; }
echo "==> release commit for $VERSION: ok"
