#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Makes one source archive of an Arch package for the release's source archive ([[legal-compliance]],
# [[step-7.2-release-pipeline]]), from a line of arch-sources.txt (tools/release/sources):
#
#   tools/release/arch-source DIR FILE url URL          downloads Arch's ready archive
#   tools/release/arch-source DIR FILE gitlab BASE TAG  makes it like Arch does: the package's
#                                                       PKGBUILD at TAG in Arch's packaging
#                                                       repository, every upstream source downloaded
#                                                       and checked against its checksums
#
# Writes DIR/FILE (and DIR/FILE.notes.txt when a generated patch differs, see below). Runs on Arch Linux as an unprivileged user (makepkg), in the release's
# container (tools/release/publish), never on the developer's PC. The PKGBUILD is only read by
# makepkg to download and check its sources: nothing is built or installed (--allsource).

set -euo pipefail

die() { echo "error: $*" >&2; exit 1; }
DIR="${1:-}" FILE="${2:-}" KIND="${3:-}"
[[ -d "$DIR" && -n "$FILE" ]] || die "usage: tools/release/arch-source DIR FILE url URL | gitlab BASE TAG"

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

case "$KIND" in
url)
    curl -sfL --retry 3 --max-time 3600 -o "$work/$FILE" "$4" || die "cannot download $4"
    ;;
gitlab)
    base="$4" tag="$5"
    url="https://gitlab.archlinux.org/archlinux/packaging/packages/$base/-/archive/$tag/$base-$tag.tar.gz"
    curl -sfL --retry 3 --max-time 600 -o "$work/pkgbuild.tar.gz" "$url" || die "cannot download $url"
    tar -xzf "$work/pkgbuild.tar.gz" -C "$work"
    mkdir -p "$work/download" "$work/out"
    src="$(find "$work" -mindepth 2 -maxdepth 2 -name PKGBUILD -printf '%h\n' | head -1)"
    [[ -n "$src" ]] || die "no PKGBUILD in $url"
    # --skippgpcheck: upstream signatures need their authors' keys; the checksums written in the
    # PKGBUILD are still checked for every file
    allsource() { (cd "$src" && SRCDEST="$work/download" SRCPKGDEST="$work/out" \
        makepkg --allsource --nodeps --skippgpcheck --force "$@" >"$work/makepkg.log" 2>&1); }
    if ! allsource; then
        # The one exception (owner, 2026-10-28): a patch that GitHub or GitLab generates from a
        # commit or a pull request can change its header lines over time, so its checksum stops
        # matching while the change to the code is the same. Only when every file that failed is
        # such a patch, the archive is made with the files just checked and downloaded, and the
        # difference is written in FILE.notes.txt next to it. Any other failure stops the release.
        mapfile -t failed < <(sed -nE 's/^ +(.+) \.\.\. FAILED$/\1/p' "$work/makepkg.log")
        generated='/(commit|commits|pull|merge_requests)/[^ ]+\.(patch|diff)$|patch-diff\.githubusercontent'
        ok=$(( ${#failed[@]} > 0 ))
        notes=""
        for f in "${failed[@]}"; do
            url="$(sed -nE "s/^\tsource(_x86_64)? = (.+::)?(.+)$/\3/p" "$src/.SRCINFO" | grep -F "/$f" | head -1)"
            [[ -z "$url" ]] && url="$(sed -nE "s/^\tsource(_x86_64)? = $f::(.+)$/\2/p" "$src/.SRCINFO" | head -1)"
            if [[ "$url" =~ $generated ]]; then
                notes+="$f ($url): generated again by its host; its checksum differs from Arch's PKGBUILD"$'\n'
            else
                ok=0
            fi
        done
        if (( ok )) && allsource --skipchecksums; then
            printf '%s\n%s' "Source archive of $base $tag, made by OwneetOS from Arch's packaging repository." \
                "Every file matched the checksums of Arch's PKGBUILD except these patches:"$'\n'"$notes" > "$work/$FILE.notes.txt"
            echo "note: $FILE: ${#failed[@]} generated patch(es) differ from Arch's checksums (written in $FILE.notes.txt)" >&2
        else
            tail -20 "$work/makepkg.log" >&2
            die "the sources of $base $tag cannot be gathered"
        fi
    fi
    made="$(find "$work/out" -name '*.src.tar.gz' | head -1)"
    [[ -n "$made" ]] || die "makepkg made no source archive for $base $tag"
    # The very version the ISO ships (the epoch's ':' spelt '_' in FILE)
    [[ "$(basename "$made" | tr ':' '_')" == "$FILE" ]] || die "$base $tag made $(basename "$made"), not $FILE"
    mv "$made" "$work/$FILE"
    ;;
*) die "unknown kind '$KIND'" ;;
esac
# A source archive is a gzip'd tar: check it reads to the end
tar -tzf "$work/$FILE" >/dev/null || die "$FILE is damaged"
mv "$work/$FILE" "$DIR/$FILE"
if [[ -f "$work/$FILE.notes.txt" ]]; then mv "$work/$FILE.notes.txt" "$DIR/"; fi
