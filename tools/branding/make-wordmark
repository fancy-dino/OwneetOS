#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Generates the OwneetOS wordmark ("owneet." with a coral dot) as an SVG made of outlines,
# so it needs no font at runtime. Runs in the builder VM (needs python-fonttools):
#
#   tools/build-in-vm 'tools/branding/make-wordmark FONT.ttf out/owneetos-wordmark.svg'
#
# FONT.ttf is Bricolage Grotesque (variable, SIL Open Font License 1.1), the display face of
# the approved design (PROJECT_RULES.md section 9). The OFL allows using its outlines in a logo.

import sys

from fontTools.pens.boundsPen import BoundsPen
from fontTools.pens.svgPathPen import SVGPathPen
from fontTools.pens.transformPen import TransformPen
from fontTools.ttLib import TTFont
from fontTools.varLib.instancer import instantiateVariableFont

TEXT = "owneet"
DOT = "."
# Same settings as the wordmark in design/mockups/wave1-mockups.html (.mini-mark).
AXES = {"wght": 800, "wdth": 78, "opsz": 96}
TRACKING_EM = -0.03
TEXT_COLOR = "#EEF1F8"
DOT_COLOR = "#FF8A5B"
PADDING_EM = 0.08


def main(font_path: str, out_path: str) -> None:
    font = instantiateVariableFont(TTFont(font_path), AXES)
    glyphs = font.getGlyphSet()
    cmap = font.getBestCmap()
    upem = font["head"].unitsPerEm
    tracking = TRACKING_EM * upem

    paths = []  # (svg path data, colour)
    x = 0.0
    bounds = [float("inf"), float("inf"), float("-inf"), float("-inf")]
    for ch, colour in [(c, TEXT_COLOR) for c in TEXT] + [(DOT, DOT_COLOR)]:
        name = cmap[ord(ch)]
        glyph = glyphs[name]
        # Font units have y going up; SVG has y going down.
        transform = (1, 0, 0, -1, x, 0)
        svg_pen = SVGPathPen(glyphs)
        glyph.draw(TransformPen(svg_pen, transform))
        bpen = BoundsPen(glyphs)
        glyph.draw(TransformPen(bpen, transform))
        if bpen.bounds:
            b = bpen.bounds
            bounds = [min(bounds[0], b[0]), min(bounds[1], b[1]), max(bounds[2], b[2]), max(bounds[3], b[3])]
        paths.append((svg_pen.getCommands(), colour))
        x += glyph.width + tracking

    pad = PADDING_EM * upem
    minx, miny, maxx, maxy = bounds[0] - pad, bounds[1] - pad, bounds[2] + pad, bounds[3] + pad
    width, height = maxx - minx, maxy - miny
    with open(out_path, "w") as out:
        out.write(
            '<?xml version="1.0" encoding="UTF-8"?>\n'
            "<!-- OwneetOS wordmark. Generated by tools/branding/make-wordmark from Bricolage Grotesque\n"
            "     (SIL Open Font License 1.1). Do not edit by hand. -->\n"
            f'<svg xmlns="http://www.w3.org/2000/svg" viewBox="{minx:.1f} {miny:.1f} {width:.1f} {height:.1f}"'
            f' width="{width:.0f}" height="{height:.0f}">\n'
        )
        for d, colour in paths:
            out.write(f'  <path fill="{colour}" d="{d}"/>\n')
        out.write("</svg>\n")
    print(f"wrote {out_path} ({width:.0f} x {height:.0f} font units)")


if __name__ == "__main__":
    if len(sys.argv) != 3:
        sys.exit("usage: make-wordmark FONT.ttf OUT.svg")
    main(sys.argv[1], sys.argv[2])
