#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Generates the final logo ([[step-7.6-final-logo-and-brand]], approved demo design/demos/7.6-logo.html)
# from the outlines of packages/owneet-branding/owneetos-wordmark.svg and the symbol drawn here:
#
#   packages/owneet-branding/owneetos-splash.svg
#       the boot splash's picture: the symbol above the word, on nothing, with the slogan's room kept
#       below them, so the logo stays in place when the console's start-up animation begins
#   frontend/owneet-frontend/src/themes/owneet/foundation/LogoData.qml
#       the same outlines and measures for the interface (foundation/Logo.qml)
#
# Needs only Python: tools/branding/make-logo

import math
import pathlib
import re

ROOT = pathlib.Path(__file__).resolve().parent.parent.parent
WORDMARK = ROOT / "packages/owneet-branding/owneetos-wordmark.svg"
SPLASH = ROOT / "packages/owneet-branding/owneetos-splash.svg"
DATA = ROOT / "frontend/owneet-frontend/src/themes/owneet/foundation/LogoData.qml"

# The word in the outlines' units (padding of the wordmark's viewBox taken off)
PADDING = 80.0
# The approved measures: the symbol's diameter and its space from the word, in those units
LEFT_SIZE, LEFT_GAP = 960, 150
ABOVE_SIZE, ABOVE_GAP = 1250, 100
SMALL_LETTERS_TOP = -527.7      # the slogan is as far from the word as the symbol looks
SPLASH_WIDTH = 800              # pixels: the word's width on the boot splash and in the animation
SLOGAN_SIZE = 40                # pixels, at that width
# All white: a pure grey looked cream next to the white on a real screen (owner, FrankenPC, 2026-11-05)
SPLASH_LETTERS, SPLASH_SYMBOL = "#FFFFFF", "#FFFFFF"


def symbol_paths():
    """The symbol in a 100 x 100 box: the disc with the gamepad cut out (even-odd), and its buttons."""
    k, c, rc = 1.2, 50, 16

    def t(x, y):
        return c + (x - c) * k, c + (y - c) * k

    def p(x, y):
        u, v = t(x, y)
        return f"{u:.2f},{v:.2f}"

    def a(r):
        return f"{r * k:.2f}"

    def circle(x, y, r):
        u, v = t(x, y)
        big = r * k
        return (f"M{u - big:.2f},{v:.2f}a{a(r)},{a(r)} 0 1,0 {2 * big:.2f},0"
                f"a{a(r)},{a(r)} 0 1,0 {-2 * big:.2f},0Z")

    top, r, cy = 33.5, 16, 49.5
    d = r * math.sqrt(0.5)
    lb, rb = (32 + d, cy + d), (68 - d, cy + d)
    body = (f"M{p(16 + rc, top)}L{p(84 - rc, top)}A{a(rc)},{a(rc)} 0 0,1 {p(84, top + rc)}L{p(84, cy)}"
            f"A{a(r)},{a(r)} 0 0,1 {p(*rb)}Q{p(50, 54.5)} {p(*lb)}A{a(r)},{a(r)} 0 0,1 {p(16, cy)}"
            f"L{p(16, top + rc)}A{a(rc)},{a(rc)} 0 0,1 {p(16 + rc, top)}Z")
    dx, dy, w, l = 32, 48.5, 2.6, 7.4
    points = [(dx - w, dy - l), (dx + w, dy - l), (dx + w, dy - w), (dx + l, dy - w), (dx + l, dy + w), (dx + w, dy + w),
              (dx + w, dy + l), (dx - w, dy + l), (dx - w, dy + w), (dx - l, dy + w), (dx - l, dy - w), (dx - w, dy - w)]
    cross = "M" + "L".join(p(x, y) for x, y in points) + "Z"
    fx, fy, o, br = 68, 48.5, 5.8, 2.7
    face = "".join(circle(x, y, br) for x, y in [(fx, fy - o), (fx + o, fy), (fx, fy + o), (fx - o, fy)])
    return "M0,50a50,50 0 1,0 100,0a50,50 0 1,0 -100,0Z" + body, cross + face


def main() -> None:
    svg = WORDMARK.read_text()
    x0, y0, width, height = (float(v) for v in re.search(r'viewBox="([^"]+)"', svg).group(1).split())
    left, right = x0 + PADDING, x0 + width - PADDING
    top, bottom = y0 + PADDING, y0 + height - PADDING
    paths = re.findall(r'<path[^>]* d="([^"]+)"', svg)
    assert len(paths) == 8, "the wordmark should have 8 letters"
    word_width, word_height = right - left, bottom - top
    shell, buttons = symbol_paths()

    # The boot splash: 800 pixels wide, with the slogan's room under the logo (in the outlines' units)
    k = SPLASH_WIDTH / word_width
    logo_height = ABOVE_SIZE + ABOVE_GAP + word_height
    room = ABOVE_GAP + SMALL_LETTERS_TOP - top + SLOGAN_SIZE / k
    letters = "".join(f'<path fill="{SPLASH_SYMBOL if i >= 6 else SPLASH_LETTERS}" d="{d}"/>' for i, d in enumerate(paths))
    SPLASH.write_text(
        '<?xml version="1.0" encoding="UTF-8"?>\n'
        "<!-- OwneetOS boot splash. Generated by tools/branding/make-logo. Do not edit by hand. -->\n"
        f'<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 {word_width:.1f} {logo_height + room:.1f}">'
        f'<g transform="translate({(word_width - ABOVE_SIZE) / 2:.1f} 0) scale({ABOVE_SIZE / 100})">'
        f'<path fill="{SPLASH_SYMBOL}" fill-rule="evenodd" d="{shell}"/><path fill="{SPLASH_SYMBOL}" d="{buttons}"/></g>'
        f'<g transform="translate({-left:.1f} {ABOVE_SIZE + ABOVE_GAP - top:.1f})">{letters}</g></svg>\n')

    quoted = ",\n        ".join(f'"{d}"' for d in paths)
    DATA.write_text(f'''// SPDX-License-Identifier: GPL-3.0-or-later
// Generated by tools/branding/make-logo. Do not edit by hand: the outlines of the final logo
// (foundation/Logo.qml): the eight letters of the word, the first six in the text's colour; the
// symbol in a 100 x 100 box, the disc with the gamepad cut out (even-odd) and its buttons; the
// approved measures, in the letters' units.
pragma Singleton
import QtQuick 2.15

QtObject {{
    readonly property var letters: [
        {quoted}
    ]
    readonly property string shell: "{shell}"
    readonly property string buttons: "{buttons}"
    readonly property real left: {left:.1f}
    readonly property real top: {top:.1f}
    readonly property real wordWidth: {word_width:.1f}
    readonly property real wordHeight: {word_height:.1f}
    readonly property real leftSize: {LEFT_SIZE}
    readonly property real leftGap: {LEFT_GAP}
    readonly property real aboveSize: {ABOVE_SIZE}
    readonly property real aboveGap: {ABOVE_GAP}
    // pixels on the boot splash and in the start-up animation: the word's width, the slogan's size,
    // its distance from the word, and the height of the logo with the slogan's room
    readonly property real splashWidth: {SPLASH_WIDTH}
    readonly property real sloganSize: {SLOGAN_SIZE}
    readonly property real sloganGap: {(ABOVE_GAP + SMALL_LETTERS_TOP - top) * k:.1f}
    readonly property real splashLogoHeight: {logo_height * k:.1f}
    readonly property real splashHeight: {(logo_height + room) * k:.1f}
}}
''')
    print(f"{SPLASH.relative_to(ROOT)}\n{DATA.relative_to(ROOT)}")
    print(f"splash {SPLASH_WIDTH} x {(logo_height + room) * k:.0f} px, slogan gap {(ABOVE_GAP + SMALL_LETTERS_TOP - top) * k:.1f} px")


if __name__ == "__main__":
    main()
