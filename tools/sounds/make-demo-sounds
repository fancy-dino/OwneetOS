#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Writes design/demos/sounds.js: the interface sounds of frontend/sounds/ as data URLs, for the
# HTML demos. A page opened from disk cannot read audio files through the Web Audio API (the
# only way to play short sounds without delay), but it can load a script. Run it again whenever
# frontend/sounds/ changes:
#
#   tools/sounds/make-demo-sounds

import base64
import pathlib

ROOT = pathlib.Path(__file__).resolve().parent.parent.parent
SOUNDS = ROOT / "frontend/sounds"
OUT = ROOT / "design/demos/sounds.js"

lines = ["// SPDX-License-Identifier: GPL-3.0-or-later",
         "// Generated by tools/sounds/make-demo-sounds from frontend/sounds/ (see SOURCES.md there).",
         "window.OWNEET_SOUNDS = {"]
for wav in sorted(SOUNDS.glob("*.wav")):
    data = base64.b64encode(wav.read_bytes()).decode("ascii")
    lines.append(f'  "{wav.stem}": "data:audio/wav;base64,{data}",')
lines.append("};")
OUT.write_text("\n".join(lines) + "\n", encoding="ascii")
print(f"{OUT.relative_to(ROOT)}: {OUT.stat().st_size // 1024} KiB")
