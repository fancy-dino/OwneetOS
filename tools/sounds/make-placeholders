#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Generates the placeholder interface sounds (design/sounds.md) that the owner has not delivered
# yet (roadmap 7.7); it writes only those files. Source: two sound packs by Kenney (kenney.nl),
# Creative Commons CC0 1.0 (public domain), pinned by URL and SHA-256. Each sound is converted to the required format:
# WAV, PCM 16-bit, 48 kHz, mono, silence at the start removed, peak level normalised (frequent
# sounds quieter). Runs in the builder VM (needs ffmpeg and network access):
#
#   tools/build-in-vm 'tools/sounds/make-placeholders frontend/sounds'

import array
import hashlib
import io
import os
import subprocess
import sys
import tempfile
import urllib.request
import wave
import zipfile

BASE = "https://kenney.nl/media/pages/assets"
PACKS = {
    "interface": (f"{BASE}/interface-sounds/fa43c1dd4d-1677589452/kenney_interface-sounds.zip",
                  "f2193d072726d6758a5f7871b2dcc54dcce0d5c35c6f0a62f92549b327c81232",
                  "Interface Sounds (1.0)"),
    "jingles": (f"{BASE}/music-jingles/f37e530b9e-1677590399/kenney_music-jingles.zip",
                "b729ba57959bd58793d2c5cafa348aaf2655d354f3da35ec4729e03ec77197b8",
                "Music Jingles"),
}

# OwneetOS sound -> (pack, file in the pack, peak level in dBFS). Frequent sounds are quieter.
# Only the sounds the owner has not delivered yet: the others in frontend/sounds/ are the owner's
# own and must never be overwritten. Remove an entry when its final sound arrives.
SOUNDS = {
    "nav-edge": ("interface", "Audio/error_004.ogg", -10),
    "notify": ("interface", "Audio/glass_001.ogg", -6),
    "game-launch": ("jingles", "Audio/Steel jingles/jingles_STEEL00.ogg", -6),
    "startup": ("jingles", "Audio/Steel jingles/jingles_STEEL07.ogg", -6),
}


def fetch(pack: str) -> zipfile.ZipFile:
    url, sha, _ = PACKS[pack]
    data = urllib.request.urlopen(url, timeout=120).read()
    got = hashlib.sha256(data).hexdigest()
    if got != sha:
        sys.exit(f"error: {url}: SHA-256 {got}, expected {sha}")
    return zipfile.ZipFile(io.BytesIO(data))


def convert(ogg: bytes, out: str, peak_db: float) -> float:
    with tempfile.NamedTemporaryFile(suffix=".ogg") as src:
        src.write(ogg)
        src.flush()
        subprocess.run(["ffmpeg", "-v", "error", "-y", "-i", src.name, "-af",
                        "silenceremove=start_periods=1:start_threshold=-55dB",
                        "-ac", "1", "-ar", "48000", "-c:a", "pcm_s16le", out], check=True)
    with wave.open(out, "rb") as w:
        params = w.getparams()
        samples = array.array("h", w.readframes(w.getnframes()))
    peak = max(1, max(abs(s) for s in samples))
    gain = (32767 * 10 ** (peak_db / 20)) / peak
    samples = array.array("h", (max(-32768, min(32767, round(s * gain))) for s in samples))
    with wave.open(out, "wb") as w:
        w.setparams(params)
        w.writeframes(samples.tobytes())
    return params.nframes / params.framerate


def main(out_dir: str) -> None:
    os.makedirs(out_dir, exist_ok=True)
    zips = {p: fetch(p) for p in PACKS}
    rows = []
    for name, (pack, member, peak) in SOUNDS.items():
        seconds = convert(zips[pack].read(member), os.path.join(out_dir, name + ".wav"), peak)
        rows.append(f"| `{name}.wav` | Kenney, {PACKS[pack][2]} | `{os.path.basename(member)}` | {seconds * 1000:.0f} ms |")
        print(f"{name}.wav  {seconds * 1000:.0f} ms")
    with open(os.path.join(out_dir, "LICENSE-Kenney.txt"), "wb") as f:
        f.write(zips["interface"].read("License.txt"))
    print("\nRows for frontend/sounds/SOURCES.md:")
    print("\n".join(rows))


if __name__ == "__main__":
    if len(sys.argv) != 2:
        sys.exit("usage: tools/sounds/make-placeholders OUT_DIR")
    main(sys.argv[1])
