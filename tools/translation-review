#
# The texts in a spreadsheet for the people who review a language ([[languages]]), and their corrections
# back into the message files. One workbook per language, for Excel, LibreOffice or Google Sheets:
# reviewers need no JSON and cannot break a file. Only the Python standard library.
#
#   tools/translation-review export [DIR]        write the workbooks (default: out/translation-review)
#   tools/translation-review import FILE         check a returned workbook, change nothing
#   tools/translation-review import FILE --apply the same, then write the corrections
#
# A text identical in every language (a button's name, the slogan, F12) is not listed: nothing to review.

import argparse
import json
import pathlib
import re
import sys
import xml.etree.ElementTree as ET
import zipfile
from xml.sax.saxutils import escape

ROOT = pathlib.Path(__file__).resolve().parent.parent
WEBSITE = ROOT.parent / "OwneetOS-website" / "src" / "i18n"
LANGUAGES = {
    "en": ("English", "plain, natural English. It is the language the others are translated from"),
    "de": ("German", 'address the reader as "du"'),
    "fr": ("French", 'address the reader as "vous", with French quotation marks (« »)'),
    "es": ("Spanish", 'address the reader as "tú", with words valid in Spain and in Latin America where possible'),
}
# Which part of the website a message belongs to: (first part of its id, what the reviewer sees, its page)
WEBSITE_PARTS = {
    "meta": ("Browser tab and search results", ""),
    "nav": ("Menu at the top of every page", ""),
    "footer": ("Bottom of every page", ""),
    "page": ("Every page but the home", ""),
    "features": ("Home page", ""),
    "hero": ("Home page", ""),
    "home": ("Home page", ""),
    "slide": ("Home page", ""),
    "plug": ("Home page, section Plug it", ""),
    "play": ("Home page, section Play it", ""),
    "own": ("Home page, section Own it", ""),
    "download": ("Home page, section Download", ""),
    "info": ("Home page, links to the other pages", ""),
    "guide": ("Guide", "guide"),
    "faq": ("Questions and answers", "faq"),
    "credits": ("Credits", "credits"),
    "contribute": ("Contribute", "contribute"),
    "privacy": ("Privacy (legal text: keep its meaning exact)", "privacy"),
    "not-found": ("Page not found", "404"),
}
ID, WHERE, ENGLISH, CURRENT, CORRECTION, NOTES, KEEP = (
    "ID (do not change)", "Where", "English", "Current text", "Your correction", "Notes", "Keep as it is")
NAMES = re.compile(r"OwneetOS|Steam|Xbox|PlayStation|Nintendo|Linux|Windows|SourceForge|GitHub|UEFI|BIOS")
PLACEHOLDER = re.compile(r"\{[A-Za-z0-9_]+\}")
CODE = re.compile(r"`[^`]+`")           # what the reader types or sees on screen, as it is
LINK = re.compile(r"\]\(([^)]+)\)")     # [text](target): the text is translated, the target is not
NS = {"m": "http://schemas.openxmlformats.org/spreadsheetml/2006/main"}
REL = "{http://schemas.openxmlformats.org/officeDocument/2006/relationships}id"


def read_messages(folder: pathlib.Path, lang: str) -> dict:
    return json.loads((folder / f"{lang}.json").read_text(encoding="utf-8"))


def write_messages(folder: pathlib.Path, lang: str, messages: dict) -> None:
    (folder / f"{lang}.json").write_text(json.dumps(messages, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")


def reviewable(folder: pathlib.Path) -> list:
    """The ids worth reviewing: a text differing between the languages."""
    all_messages = [read_messages(folder, lang) for lang in LANGUAGES]
    return [key for key in all_messages[0] if key != "@meta" and len({m[key] for m in all_messages}) > 1]


def where(key: str) -> str:
    part = key.split(".")[0]
    if part not in WEBSITE_PARTS:
        sys.exit(f"{key}: add its part of the website to WEBSITE_PARTS")
    return WEBSITE_PARTS[part][0]


def address(key: str, lang: str) -> str:
    page = WEBSITE_PARTS[key.split(".")[0]][1]
    parts = [] if lang == "en" else [lang]
    if page:
        parts.append(page)
    return "/".join(["owneetos.org"] + parts)


def keep(text: str) -> str:
    found = list(dict.fromkeys(PLACEHOLDER.findall(text) + NAMES.findall(text)))
    found += CODE.findall(text) + [f"the link ...]({target})" for target in LINK.findall(text)]
    if "**" in text:
        found.append("** around the bold words")
    return ", ".join(found)


# ---- Writing a workbook

def column(index: int) -> str:
    return chr(ord("A") + index)


def cell(col: int, row: int, text: str, style: int) -> str:
    ref = f"{column(col)}{row}"
    if not text:
        return f'<c r="{ref}" s="{style}"/>'
    return f'<c r="{ref}" s="{style}" t="inlineStr"><is><t xml:space="preserve">{escape(text)}</t></is></c>'


def lines(text: str, width: int) -> int:
    return sum(max(1, -(-len(part) // max(1, width - 2))) for part in text.split("\n"))


