def read_messages(folder: pathlib.Path, lang: str) -> dict:
    return json.loads((folder / f"{lang}.json").read_text(encoding="utf-8"))


def write_messages(folder: pathlib.Path, lang: str, messages: dict) -> None:
    (folder / f"{lang}.json").write_text(json.dumps(messages, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")


def flat(messages: dict) -> dict:
    """Every text by id; a message with plural forms gives one per form: "games.count [one]"."""
    texts = {}
    for key, value in messages.items():
        if key == "@meta":
            continue
        if isinstance(value, dict):
            texts.update({f"{key} [{form}]": text for form, text in value.items()})
        else:
            texts[key] = value
    return texts


def set_text(messages: dict, text_id: str, text: str) -> None:
    match = re.fullmatch(r"(.+) \[(\w+)\]", text_id)
    if match:
        messages[match.group(1)][match.group(2)] = text
    else:
        messages[text_id] = text


def reviewable(folder: pathlib.Path) -> list:
    """The ids worth reviewing: a text differing between the languages."""
    all_texts = [flat(read_messages(folder, lang)) for lang in LANGUAGES]
    return [key for key in all_texts[0] if len({t[key] for t in all_texts}) > 1]


def website_where(key: str, lang: str) -> str:
    part = key.split(".")[0]
    if part not in WEBSITE_PARTS:
        sys.exit(f"{key}: add its part of the website to WEBSITE_PARTS")
    name, page = WEBSITE_PARTS[part]
    return name + "\n" + "/".join(["owneetos.org"] + ([] if lang == "en" else [lang]) + ([page] if page else []))


def console_where(key: str, lang: str) -> str:
    part = key.split(".")[0]
    if part not in CONSOLE_PARTS:
        sys.exit(f"{key}: add its screen to CONSOLE_PARTS")
    return CONSOLE_PARTS[part]


# The sheets of a workbook: (name, folder of the message files, what the column Where says)
SHEETS = {"Website": (WEBSITE, website_where), "Console": (CONSOLE, console_where)}


def keep(text: str) -> str:
    found = list(dict.fromkeys(PLACEHOLDER.findall(text) + NAMES.findall(text)))
    found += CODE.findall(text) + [f"the link ...]({target})" for target in LINK.findall(text)]
    if "**" in text:
        found.append("** around the bold words")
    return ", ".join(found)


# ---- Writing a workbook

def column(index: int) -> str:
    return chr(ord("A") + index)


def cell(col: int, row: int, text: str, style: int) -> str:
    ref = f"{column(col)}{row}"
    if not text:
        return f'<c r="{ref}" s="{style}"/>'
    return f'<c r="{ref}" s="{style}" t="inlineStr"><is><t xml:space="preserve">{escape(text)}</t></is></c>'


def lines(text: str, width: int) -> int:
    return sum(max(1, -(-len(part) // max(1, width - 2))) for part in text.split("\n"))


