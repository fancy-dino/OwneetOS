{
  "manifest_version": 3,
  "name": "OwneetOS",
  "version": "0.1.0",
  "description": "Controller support for the OwneetOS web apps.",
  "minimum_chrome_version": "116",
  "permissions": ["nativeMessaging"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://*/*"],
      "js": ["content/spatnav.js", "content/youtube-tv.js", "content/input.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
